<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal ad-hoc entitlements for the hermetic Mac Catalyst Keychain-deny probe.
  Mirrors product posture of RAVEN-Catalyst.entitlements for App Groups:
  app-sandbox=false (mesh), and no application-groups key.
  Unsandboxed App Group filesystem is untrusted storage — not a secrecy boundary.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
