// New mesh expectation Q&As (Persian)
"faq.mesh_simple.q" = "شبکه مش به زبان ساده چگونه کار می‌کند؟";
"faq.mesh_simple.a" = "تصور کنید در کلاس یک یادداشت کاغذی رد می‌کنید. پیام شما از یک گوشی نزدیک به گوشی دیگری از طریق بلوتوث می‌پرد تا به دوستتان برسد — بدون نیاز به اینترنت. هر گوشی در بین راه فقط آن را رد می‌کند بدون اینکه بخواند.";
"faq.mesh_limits.q" = "محدودیت‌های شبکه مش چیست؟";
"faq.mesh_limits.a" = "مش فوری نیست — ممکن است بسته به تعداد گره‌ها، رسیدن پیام دقایقی طول بکشد. فقط متن پشتیبانی می‌شود (نه عکس یا فایل)، در محدوده بلوتوث (~۳۰ تا ۱۰۰ متر بین دستگاه‌ها) کار می‌کند، نیاز به فعال بودن برنامه دارد، هنوز از چت گروهی پشتیبانی نمی‌کند و برای ارتباطات اضطراری طراحی نشده است.";

"faq.q1" = "راوِن چیست و چه تفاوتی دارد؟";
"faq.a1" = "راوِن یک پیام‌رسان خصوصی و امن با شبکه مش آفلاین است. بر خلاف سایر برنامه‌ها، راوِن می‌تواند پیام‌ها را از طریق بلوتوث بدون اینترنت ارسال کند — دستگاه به دستگاه.";
"faq.q2" = "برای ایجاد حساب چه چیزی نیاز دارم؟";
"faq.a2" = "یک نام کاربری و آدرس ایمیل. همچنین می‌توانید با Apple یا Google وارد شوید. عکس پروفایل و بیو اختیاری است.";
"faq.q3" = "اگر ایمیل ارائه ندهم چه می‌شود؟";
"faq.a3" = "آدرس ایمیل برای ایجاد حساب و بازیابی لازم است. همچنین می‌توانید با Apple ID یا حساب Google وارد شوید.";
"faq.q4" = "چگونه حساب خود را حذف کنم؟";
"faq.a4" = "به تنظیمات → حساب → حذف حساب بروید. داده‌های شما ظرف ۳۰ روز به طور دائم حذف می‌شود. این عمل قابل بازگشت نیست.";
"faq.q5" = "چگونه نام کاربری خود را تغییر دهم؟";
