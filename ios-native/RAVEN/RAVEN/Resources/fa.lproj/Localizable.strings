// Privacy Policy
"privacy_policy.title" = "سیاست حفظ حریم خصوصی";
"privacy_policy.last_updated" = "آخرین به‌روزرسانی: ژانویه ۲۰۲۶";
"privacy_policy.section1.title" = "۱. اطلاعاتی که جمع‌آوری می‌کنیم";
"privacy_policy.section1.text" = "ما حداقل اطلاعات شخصی لازم برای ارائه خدمات را جمع‌آوری می‌کنیم. این شامل نام کاربری، اطلاعات پروفایل و پیام‌های رمزگذاری شده می‌شود.";
"privacy_policy.section2.title" = "۲. نحوه استفاده از اطلاعات شما";
"privacy_policy.section2.text" = "اطلاعات شما فقط برای ارائه، نگهداری و بهبود خدمات راوِن استفاده می‌شود. ما هرگز داده‌های شما را به شخص ثالث نمی‌فروشیم.";
"privacy_policy.section3.title" = "۳. رمزگذاری سرتاسری";
"privacy_policy.section3.text" = "تمام پیام‌ها به صورت سرتاسری رمزگذاری می‌شوند. فقط شما و گیرنده مورد نظر می‌توانید پیام‌های خود را بخوانید. ما نمی‌توانیم به محتوای ارتباطات شما دسترسی داشته باشیم.";
"privacy_policy.section4.title" = "۴. داده‌های مکانی";
"privacy_policy.section4.text" = "با اجازه شما، از موقعیت مکانی شما برای نمایش پست‌های نزدیک در فید محلی استفاده می‌کنیم. داده‌های مکانی فقط هنگام استفاده از برنامه استفاده می‌شود و در سرورهای ما ذخیره نمی‌شود.";
"privacy_policy.section5.title" = "۵. ویژگی‌های هوش مصنوعی";
"privacy_policy.section5.text" = "راوِن شامل ویژگی‌های هوش مصنوعی اختیاری است که توسط گوگل جمینای پشتیبانی می‌شود. وقتی از @ask در نظرات استفاده می‌کنید، محتوای پست شما ممکن است با گوگل به اشتراک گذاشته شود تا پاسخ‌ها تولید شود. پاسخ‌های AI بعد از تحویل ذخیره نمی‌شوند.";
"privacy_policy.section6.title" = "۶. خدمات شخص ثالث";
"privacy_policy.section6.text" = "ما از خدمات شخص ثالث زیر استفاده می‌کنیم: ورود گوگل برای احراز هویت، گوگل جمینای برای ویژگی‌های AI، و اعلان‌های پوش اپل برای تحویل پیام. هر سرویس سیاست حفظ حریم خصوصی خود را دارد.";
"privacy_policy.section7.title" = "۷. نگهداری داده‌ها";
"privacy_policy.section7.text" = "پیام‌ها به صورت محلی در دستگاه شما ذخیره می‌شوند و به صورت اختیاری با پشتیبان‌گیری ابری رمزگذاری شده همگام می‌شوند. شما می‌توانید داده‌های خود را در هر زمان حذف کنید.";
"privacy_policy.section8.title" = "۸. حقوق شما";
"privacy_policy.section8.text" = "شما حق دسترسی، اصلاح یا حذف داده‌های شخصی خود را دارید. برای حذف حساب خود، به تنظیمات > حساب > بستن حساب بروید. برای درخواست‌های حریم خصوصی، با info@raven-messager.com تماس بگیرید.";

