"pp.general.q4.q" = "האם ניתן להשתמש ב-Raven בלי לספק מידע אישי מסוים?";
"pp.general.q4.a" = "אתה צריך דוא\"ל להרשמה. כל השאר (ביו, תמונה וכו\') אופציונלי.";

// PP Account
"pp.account.q1.q" = "אילו פרטי חשבון נשמרים?";
"pp.account.q1.a" = "שם המשתמש שלך, דוא\"ל, מידע פרופיל ואסימוני אימות.";
"pp.account.q2.q" = "האם כתובת הדוא\"ל שלי חובה או אופציונלית?";
"pp.account.q2.a" = "כתובת דוא\"ל נדרשת. אתה יכול גם להתחבר עם Apple ID או חשבון Google.";
"pp.account.q3.q" = "האם כתובת הדוא\"ל שלי מאומתת ומאוחסנת בבטחה?";
"pp.account.q3.a" = "כן, מאומתת בהרשמה. מאוחסנת במסד הנתונים שלנו בנוהלי אבטחה סטנדרטיים.";
"pp.account.q4.q" = "האם אוכל לשנות או למחוק את פרטי החשבון שלי?";
"pp.account.q4.a" = "כן. ערוך פרופיל בהגדרות. מחיקת חשבון מוחקת הכל לצמיתות.";
"pp.account.q5.q" = "מה קורה עם התעודה המזהה והסלפי שלי במהלך האימות?";
"pp.account.q5.a" = "בעת הגשת בקשה לתג מאומת, תעודת הזהות הממשלתית שלך וסלפי מועברים בצורה מאובטחת לצורך אישור זהות בלבד. מסמכים אלה נמחקים לצמיתות מהשרתים שלנו מיד לאחר השלמת תהליך הבדיקה. איננו מאחסנים את תעודת הזהות שלך או נתונים ביומטריים.";

// PP Contacts
"pp.contacts.q1.q" = "למה Raven מבקש גישה לאנשי הקשר שלי?";
