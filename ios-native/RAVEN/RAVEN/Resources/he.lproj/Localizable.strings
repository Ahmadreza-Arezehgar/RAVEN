"pp.contacts.q5.a" = "כן. אתה יכול לדלג על זה ולהוסיף חברים ידנית.";

// PP Location
"pp.location.q1.q" = "האם Raven אוסף את המיקום שלי?";
"pp.location.q1.a" = "בעת שימוש בפיד המקומי או שיתוף מיקום בצ\'אט, אנו ניגשים אליו בחזית. אם תפעיל Background Mesh Relay, iOS משתמש בשינויי מיקום אזוריים כדי להעיר את ה-Bluetooth של האפליקציה ברקע, אך הקואורדינטות הגיאוגרפיות המדויקות שלך לעולם אינן נעקבות, מאוחסנות או נשלחות לשרתים שלנו ברקע.";
"pp.location.q2.q" = "מתי משתמשים בנתוני מיקום?";
"pp.location.q2.a" = "הפיד המקומי מראה פוסטים בקרבתך. שיתוף מיקום שולח את הקואורדינטות שלך לנמעני הצ\'אט.";
"pp.location.q3.q" = "מה ההבדל בין מיקום נוכחי למיקום חי?";
"pp.location.q3.a" = "נוכחי: חד-פעמי. חי: מתעדכן ברציפות למשך הזמן שנבחר.";
"pp.location.q4.q" = "כמה זמן משותף מיקום חי?";
"pp.location.q4.a" = "15 דקות, שעה או 8 שעות - אתה בוחר.";
"pp.location.q5.q" = "האם אוכל לכבות שיתוף מיקום?";
"pp.location.q5.a" = "כן. סרב להרשאה בהגדרות iOS או פשוט אל תשתמש בתכונות מיקום.";
"pp.location.q6.q" = "האם נתוני מיקום נשמרים לצמיתות?";
"pp.location.q6.a" = "פוסטים עם מיקום שומרים קואורדינטות משוערות. מיקום חי לא נשמר אחרי שהוא מסתיים.";

// PP Messaging
"pp.messaging.q1.q" = "האם הודעות מוצפנות מקצה לקצה?";
