"pp.messaging.q4.a" = "מועברות דרך מכשירים קרובים, ואז מסונכרנות לשרתים כשיש חיבור.";
"pp.messaging.q5.q" = "האם הודעות שנמחקו מוסרות לצמיתות?";
"pp.messaging.q5.a" = "\"מחק לכולם\" מסיר מהשרתים. \"מחק לי\" מסיר רק מהמכשיר שלך.";
