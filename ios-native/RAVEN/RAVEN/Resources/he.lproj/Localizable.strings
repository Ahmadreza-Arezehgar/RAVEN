// TOS Sections
"tos.s1.title" = "1. קבלת התנאים";
"tos.s1.content" = "• בשימוש ב-Raven, אתה מסכים לתנאי שימוש אלה.\n• אם אינך מסכים, אין להשתמש באפליקציה.\n• המשך שימוש משמעו קבלת עדכונים.";
"tos.s2.title" = "2. כשירות";
"tos.s2.content" = "• עליך להיות בן 13 לפחות (או 16 בהתאם לאזור).\n• אתה מאשר שהמידע שאתה מספק מדויק.\n• חשבון אחד לאדם אלא אם הותר במפורש.";
"tos.s3.title" = "3. אחריות חשבון";
"tos.s3.content" = "• אתה אחראי לפעילות בחשבונך.\n• עליך לשמור על פרטי ההתחברות שלך בבטחה.\n• Raven אינו אחראי לגישה לא מורשית שנגרמה מרשלנות משתמש.";
"tos.s4.title" = "4. תוכן משתמש";
"tos.s4.content" = "• אתה הבעלים של התוכן שאתה יוצר (הודעות, פוסטים, סטוריז).\n• בפרסום תוכן, אתה מעניק ל-Raven רישיון מוגבל להצגה והפצה בתוך האפליקציה.\n• אתה אחראי למה שאתה משתף.";
"tos.s5.title" = "5. תוכן והתנהגות אסורים";
"tos.s5.content" = "משתמשים אסור להם:\n• לפרסם תוכן בלתי חוקי, אלים או פוגעני\n• להטריד, לאיים או להתחזות לאחרים\n• לשתף ספאם, תוכנות זדוניות או הונאות\n• להפר זכויות קניין רוחני\n\nRaven רשאי להסיר תוכן או להשעות חשבונות שמפרים כללים אלה.";
"tos.s6.title" = "6. הודעות ותקשורת";
"tos.s6.content" = "• הודעות עשויות להיות מסופקות דרך אינטרנט או רשת mesh.\n• רשת mesh תומכת בהודעות טקסט בלבד.\n• Raven אינו מבטיח מסירה בזמן אמת.";
"tos.s7.title" = "7. הסתייגות רשת Mesh";
"tos.s7.content" = "• Mesh מסופק כמות שהוא ותלוי במכשירים קרובים.\n• Raven אינו אחראי לעיכובים, אובדן או כפילות של הודעות.\n• Mesh אינו מיועד לתקשורת חירום.";
"tos.s8.title" = "8. פוסטים, סטוריז ונראות";
"tos.s8.content" = "• נראות התוכן תלויה במצב שנבחר (ציבורי, חברים, מקומי).\n• סטוריז עשויים להיות מוגבלים בצפיות או בזמן.";
"tos.s9.title" = "9. חדרי קול";
"tos.s9.content" = "• חדרי קול הם חיים בלבד אלא אם צוין אחרת.\n• Raven לא מקליט חדרים כברירת מחדל.\n• מנחים יכולים למתן, להשתיק או להסיר משתמשים.";
"tos.s10.title" = "10. סטטוס מקוון ונוכחות";
"tos.s10.content" = "• סטטוס מקוון הוא משוער.\n• משתמשים יכולים לשלוט בנראות דרך ההגדרות.";
"tos.s11.title" = "11. העלאות מדיה";
"tos.s11.content" = "• מדיה שהועלתה חייבת לעמוד בכללי התוכן.\n• Raven עשוי לדחוס או לעבד מדיה לביצועים.";
"tos.s12.title" = "12. התראות";
"tos.s12.content" = "• התראות מסופקות כנוחות.\n• Raven אינו אחראי להתראות שהוחמצו.\n• משתמשים שולטים בהעדפות ההתראות.";
"tos.s13.title" = "13. השעיה וסיום חשבון";
"tos.s13.content" = "Raven רשאי:\n• להשעות או לסיים חשבונות בגין הפרות\n• להסיר תוכן ללא הודעה מוקדמת\n\nמשתמשים יכולים:\n• למחוק את חשבונם בכל זמן";
"tos.s14.title" = "14. קניין רוחני";
"tos.s14.content" = "• Raven, הלוגו שלו, ממשק המשתמש והקוד הם רכוש Raven.\n• תוכן המשתמש נשאר בבעלות המשתמש.";
"tos.s15.title" = "15. הגבלת אחריות";
"tos.s15.content" = "• Raven מסופק \"כמו שהוא\".\n• השימוש הוא על אחריותך.";
"tos.s16.title" = "16. שיפוי";
"tos.s16.content" = "אתה מסכים לשפות את Raven מתביעות שנגרמו על ידי:\n• התוכן שלך\n• שימוש לרעה באפליקציה\n• הפרת חוקים או תנאים אלה";
"tos.s17.title" = "17. שינויים בתנאים";
"tos.s17.content" = "• Raven רשאי לעדכן תנאים בכל זמן.\n• המשך שימוש משמעו קבלת שינויים.";
"tos.s18.title" = "18. דין חל";
"tos.s18.content" = "• תנאים אלה כפופים לחוקים המקומיים והבינלאומיים החלים.";
"tos.s19.title" = "19. יצירת קשר";
"tos.s19.content" = "לפניות משפטיות או תמיכה:\n• דוא\"ל: privacy@raven-messager.com\n• אזור תמיכה באפליקציה";

// FAQ
"faq.title" = "שאלות נפוצות";
"faq.q1" = "מה זה Raven ואיזה סוג אפליקציה זו?";
"faq.a1" = "Raven היא אפליקציית מסרים חברתית מאובטחת שמשלבת תכונות של מסנג\'ר ורשת חברתית. היא כוללת פוסטים, סטוריז, חדרי קול ורשת mesh לתקשורת ללא חיבור.";
"faq.q2" = "מה ההבדל בין פוסטים ציבוריים, חברים ומקומיים?";
"faq.a2" = "פוסטים ציבוריים גלויים לכולם. פוסטי חברים גלויים רק לחבריך. פוסטים מקומיים מופיעים למשתמשים באזור הגיאוגרפי שלך.";
"faq.q3" = "איך האפליקציה עובדת בלי חיבור אינטרנט?";
"faq.a3" = "Raven משתמש ברשת mesh דרך בלוטות כדי לשלוח ולקבל הודעות דרך משתמשי Raven קרובים, גם בלי אינטרנט.";
"faq.q4" = "מה זה רשת mesh ומתי היא בשימוש?";
"faq.a4" = "רשת mesh יוצרת רשת peer-to-peer באמצעות בלוטות. היא משמשת אוטומטית כשאין לך חיבור אינטרנט.";
"faq.q5" = "למה רק הודעות טקסט יכולות להישלח דרך mesh?";
"faq.a5" = "לבלוטות יש רוחב פס מוגבל, אז רק הודעות טקסט קטנות יכולות להיות מועברות ביעילות.";
"faq.q6" = "האם הודעות ופוסטים נשמרים כשאני לא מחובר?";
"faq.a6" = "כן, כל ההודעות והפוסטים שלך נשמרים מקומית במכשיר שלך. ברגע שאתה מתחבר מחדש, הם מסתנכרנים אוטומטית.";
"faq.q7" = "מה קורה לנתוני mesh כשהמכשיר מתחבר מחדש?";
"faq.a7" = "בהתחברות מחדש, הודעות mesh ממתינות מסתנכרנות לשרת ומסופקות כרגיל.";
"faq.q8" = "איך סטוריז עובדים ב-Raven?";
"faq.a8" = "סטוריז הם תמונות או סרטונים שנעלמים אחרי 24 שעות. אתה יכול לשתף אותם עם כולם או רק עם חבריך.";
"faq.q9" = "למה חלק מהסטוריז ניתנים לצפייה רק פעם אחת?";
"faq.a9" = "יוצרי סטוריז יכולים להפעיל מצב \"צפייה חד-פעמית\" לפרטיות.";
"faq.q10" = "האם בעל הסטורי יכול לראות מי צפה?";
"faq.a10" = "כן, בעלי סטוריז יכולים לראות רשימה של כל מי שצפה, כולל זמן הצפייה ותגובות.";
"faq.q11" = "למה צילום מסך מושבת לחלק מהסטוריז?";
"faq.a11" = "יוצרים יכולים להשבית צילומי מסך כדי למנוע שמירת תוכנם ללא רשות.";
"faq.q12" = "מה הם חדרי קול?";
"faq.a12" = "חדרי קול הם מרחבי שיחת אודיו חיים שבהם מספר משתמשים יכולים לדבר בזמן אמת.";
"faq.q13" = "מי יכול ליצור חדר קול?";
"faq.a13" = "כל משתמש Raven מאומת יכול ליצור חדר קול. היוצר הופך למנחה עם שליטה מלאה.";
"faq.q14" = "מה ההבדל בין חדרי קול ציבוריים ושל חברים?";
"faq.a14" = "חדרים ציבוריים מופיעים בפיד המקומי וכל אחד יכול להצטרף. חדרי חברים הם בהזמנה בלבד.";
"faq.q15" = "איך משתמשים מצטרפים לחדר קול?";
"faq.a15" = "הקש על כרטיס חדר בפיד או על קישור הזמנה. תצטרף כמאזין ותוכל לבקש לדבר עם \"הרמת יד\".";
"faq.q16" = "מה עושה תכונת הרמת היד?";
"faq.a16" = "הרמת יד מודיעה למנחה שאתה רוצה לדבר. המנחה יכול אז לקדם אותך ממאזין לדובר.";
"faq.q17" = "האם מנחה החדר יכול להשתיק או להסיר משתמשים?";
"faq.a17" = "כן, מנחים יכולים להשתיק דוברים, להסיר הרשאת דיבור או להוציא משתתפים מהחדר.";
"faq.q18" = "למה המצלמה מושבתת בחדרי קול?";
"faq.a18" = "חדרי קול הם אודיו בלבד בעיצובם כדי להפחית שימוש ברוחב פס.";
"faq.q19" = "איך עובד סטטוס מקוון / נראה לאחרונה?";
"faq.a19" = "הסטטוס המקוון שלך מראה נקודה ירוקה כשאתה פעיל. נראה לאחרונה מראה מתי השתמשת ב-Raven לאחרונה.";
"faq.q20" = "האם אוכל להסתיר את הסטטוס המקוון שלי?";
"faq.a20" = "כן, עבור להגדרות > פרטיות. שים לב: אם תסתיר את שלך, לא תוכל לראות את של אחרים.";
"faq.q21" = "איך עובד שיתוף מיקום?";
"faq.a21" = "אתה יכול לשתף את מיקומך הנוכחי או החי בכל צ\'אט. נמענים רואים את המיקום שלך על מפה.";
"faq.q22" = "מה ההבדל בין מיקום נוכחי למיקום חי?";
"faq.a22" = "מיקום נוכחי הוא תמונת מצב חד-פעמית. מיקום חי מעדכן את מיקומך ברציפות.";
"faq.q23" = "כמה זמן נמשך מיקום חי?";
"faq.a23" = "אתה יכול לבחור 15 דקות, שעה או 8 שעות. אתה יכול להפסיק לשתף בכל זמן.";
"faq.q24" = "האם שיתוף מיקום דורש הרשאות מערכת?";
"faq.a24" = "כן, עליך להעניק הרשאת מיקום כשתתבקש. Raven ניגש למיקום רק כשאתה בוחר לשתף.";
"faq.q25" = "איך אוכל למחוק הודעות?";
"faq.a25" = "לחץ לחיצה ארוכה על הודעה והקש מחק. אתה יכול למחוק רק לעצמך או לכולם.";
"faq.q26" = "האם מחיקת הודעה היא רק לי או גם למשתמש האחר?";
"faq.a26" = "בעת מחיקת ההודעות שלך, אתה יכול לבחור \"מחק לכולם\" כדי להסיר מכל המכשירים.";
"faq.q27" = "למה חלק מההודעות מופיעות כלא נקראו אחרי התקנה מחדש?";
"faq.a27" = "אישורי קריאה נשמרים מקומית. אחרי התקנה מחדש, האפליקציה מורידה הודעות מחדש אבל לא בהכרח את סטטוס הקריאה.";
"faq.q28" = "למה הודעה חדשה לא מופיעה לפעמים ברשימת הצ\'אטים?";
"faq.a28" = "משוך למטה לרענון רשימת הצ\'אטים. אם משתמשים ב-mesh, הודעות עשויות לקחת זמן.";
"faq.q29" = "איך אני יוצר קבוצה?";
"faq.a29" = "בהודעות, הקש קבוצה חדשה, בחר חברים, הוסף שם קבוצה ותמונה אופציונלית, ואז הקש צור.";
"faq.q30" = "למה שם או אווטאר הקבוצה מופיע לפעמים בצורה שגויה?";
"faq.a30" = "זה יכול לקרות בגלל עיכובי סנכרון. משוך לרענון או המתן רגע.";
"faq.q31" = "למה קבוצה חדשה מופיעה בטלפון שלי אבל לא אצל אחרים?";
"faq.a31" = "יצירת קבוצה מסתנכרנת דרך התראת push. חברים יראו אותה כשיפתחו את האפליקציה.";
"faq.q32" = "איך Raven מזהה מי מאנשי הקשר שלי משתמש באפליקציה?";
"faq.a32" = "באישורך, Raven בודק מספרי טלפון מול משתמשים רשומים בצורה מאובטחת.";
"faq.q33" = "למה האפליקציה מבקשת גישה לאנשי הקשר שלי?";
"faq.a33" = "כדי לעזור לך למצוא חברים שכבר ב-Raven. גישת אנשי קשר היא אופציונלית.";
"faq.q34" = "מה קורה אם לאיש קשר אין Raven מותקן?";
"faq.a34" = "אתה יכול להזמין אותם עם תכונת ההזמנה ששולחת קישור הורדה.";
"faq.q35" = "איך עובדת תכונת ההזמנה?";
"faq.a35" = "הקש הזמן באיש קשר כדי לשתף קישור הורדה בדוא\"ל או כל אפליקציה אחרת.";
"faq.q36" = "למה התראות לפעמים לא מופיעות באייפון?";
"faq.a36" = "בדוק בהגדרות > התראות ש-Raven מקבל הרשאה. ודא שנא להפריע כבוי.";
"faq.q37" = "אילו סוגי התראות Raven שולח?";
"faq.a37" = "הודעות, בקשות חברות, לייקים/תגובות, צפיות בסטוריז והזמנות לחדרי קול.";
"faq.q38" = "האם אוכל להתאים אישית את הגדרות ההתראות?";
"faq.a38" = "כן, עבור להגדרות > התראות כדי להפעיל/לכבות סוגי התראות ספציפיים.";
"faq.q39" = "איך Raven מגן על פרטיות המשתמש?";
"faq.a39" = "כל ההודעות מוצפנות מקצה לקצה. אנחנו לא מוכרים נתונים ונותנים לך שליטה על מה שאתה משתף.";
"faq.q40" = "האם הנתונים שלי מוצפנים?";
"faq.a40" = "כן, כל ההודעות משתמשות בהצפנה מקצה לקצה. רק אתה והנמען יכולים לקרוא אותן.";
"faq.q41" = "איך אוכל לדווח על משתמש או תוכן?";
"faq.a41" = "הקש על שלוש הנקודות (...) בכל פוסט, פרופיל או הודעה ובחר דיווח.";
"faq.q42" = "איך אוכל לחסום משתמש אחר?";
"faq.a42" = "עבור לפרופיל שלו, הקש על שלוש הנקודות ובחר חסימה. משתמשים חסומים לא יכולים לשלוח לך הודעות.";
"faq.q43" = "כמה תמונות ניתן לכלול בפוסט אחד?";
"faq.a43" = "כרגע, כל פוסט תומך בתמונה אחת. תמיכה במספר תמונות עשויה להתווסף בעדכונים עתידיים.";
"faq.q44" = "למה מספר תמונות מוצגות כפוסט אחד במקום פוסטים נפרדים?";
"faq.a44" = "כדי לשמור על פיד נקי ומאורגן, תמונות קשורות מקובצות יחד בפוסט קרוסלה.";
"faq.q45" = "מה פירוש התווית \"נשלח דרך Mesh\"?";
"faq.a45" = "זה מציין שההודעה נשלחה דרך רשת mesh בלוטות כי לא היה לך חיבור אינטרנט.";
"faq.q46" = "האם ניתן להגביל פוסטים או סטוריז לחברים בלבד?";
"faq.a46" = "כן, בעת יצירת פוסט או סטורי, בחר \"חברים\" כקהל להגבלת הנראות.";
"faq.q47" = "למה אני לא יכול לצפות בפוסט או סטורי שוב?";
"faq.a47" = "תוכן מסוים הוא \"חד-פעמי\" בעיצובו. לאחר צפייה, הוא לא יופיע שוב בפיד שלך.";
"faq.q48" = "האם ניתן לשמור פוסטים או סטוריז לצפייה מאוחרת?";
"faq.a48" = "סטוריז עם \"צפייה חד-פעמית\" לא ניתנים לשמירה. פוסטים רגילים ניתנים לסימנייה.";
"faq.q49" = "למה מסך ההתחברות מופיע לרגע בפתיחת האפליקציה מחדש?";
"faq.a49" = "זוהי בדיקת אימות קצרה. אם זה נמשך, נסה לסגור ולפתוח מחדש את האפליקציה.";
"faq.q50" = "איפה אוכל לשנות שפה, פרטיות והגדרות התראות?";
"faq.a50" = "עבור לחשבון > הגדרות. תמצא שפה, פרטיות, התראות ואפשרויות נוספות בסעיף הכללי.";
"faq.q51" = "מהו RAVEN+?";
"faq.a51" = "RAVEN+ הוא המנוי הפרימיום שלנו שפותח העלאת קבצים עד 2GB, הודעות קוליות של 10 דקות, תכונות AI ללא הגבלה, Ghost Mode ועדיפות ניתוב VIP ב-Mesh.";
"faq.q52" = "מהו Ghost Mode?";
"faq.a52" = "תכונה בלעדית ל-RAVEN+ שמאפשרת לך לקרוא הודעות מבלי לשלוח אישור קריאה (וי כפול כחול) לשולח.";
"faq.q53" = "האם יש מגבלות על תכונות AI?";
"faq.a53" = "משתמשים חינמיים יכולים לתמלל 3 הודעות קוליות ולשאול את Gemini 5 שאלות ביום. מנויי RAVEN+ נהנים מגישה ללא הגבלה.";
"faq.q54" = "איך אני מנהל את המנוי שלי?";
"faq.a54" = "המנויים מנוהלים באופן מאובטח על ידי Apple. ניתן לבטל בכל עת דרך הגדרות iPhone > Apple ID > מנויים.";

