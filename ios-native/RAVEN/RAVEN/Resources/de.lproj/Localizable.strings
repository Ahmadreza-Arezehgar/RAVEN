// PP General
"pp.general.q1.q" = "Welche persönlichen Daten erhebt Raven?";
"pp.general.q1.a" = "Benutzername, E-Mail, Profilfoto, Beiträge, Nachrichten und Standort bei Nutzung lokaler Funktionen.";
"pp.general.q2.q" = "Warum erhebt Raven persönliche Daten?";
"pp.general.q2.a" = "Damit die App funktioniert. Wir benötigen Ihre E-Mail zur Verifizierung und speichern Nachrichten, damit Sie sie empfangen können.";
"pp.general.q3.q" = "Welche Daten sind zur Kontoerstellung erforderlich?";
"pp.general.q3.a" = "E-Mail-Adresse zur Verifizierung und ein Benutzername.";
"pp.general.q4.q" = "Kann Raven ohne bestimmte persönliche Daten genutzt werden?";
"pp.general.q4.a" = "Sie benötigen eine E-Mail-Adresse zur Anmeldung. Alles andere (Bio, Foto usw.) ist optional.";

// PP Account
"pp.account.q1.q" = "Welche Kontoinformationen werden gespeichert?";
"pp.account.q1.a" = "Ihr Benutzername, E-Mail, Profilinfo und Authentifizierungs-Token.";
"pp.account.q2.q" = "Ist meine E-Mail-Adresse erforderlich oder optional?";
"pp.account.q2.a" = "Eine E-Mail-Adresse ist erforderlich. Sie können sich auch mit Apple ID oder Google-Konto anmelden.";
"pp.account.q3.q" = "Wird meine E-Mail-Adresse verifiziert und sicher gespeichert?";
"pp.account.q3.a" = "Ja, bei der Anmeldung verifiziert. In unserer Datenbank mit Standard-Sicherheitspraktiken gespeichert.";
"pp.account.q4.q" = "Kann ich meine Kontoinformationen ändern oder löschen?";
"pp.account.q4.a" = "Ja. Profil in den Einstellungen bearbeiten. Konto löschen entfernt alles dauerhaft.";
"pp.account.q5.q" = "Was passiert mit meinem Ausweis und Selfie bei der Verifizierung?";
"pp.account.q5.a" = "Bei der Beantragung eines verifizierten Abzeichens werden Ihr amtlicher Ausweis und ein Selfie sicher zur Identitätsbestätigung übertragen. Diese Dokumente werden sofort nach Abschluss des Prüfungsprozesses dauerhaft von unseren Servern gelöscht. Wir speichern weder Ihren Ausweis noch biometrische Daten.";

// PP Contacts
"pp.contacts.q1.q" = "Warum fordert Raven Zugriff auf meine Kontakte?";
"pp.contacts.q1.a" = "Um Ihnen zu zeigen, welche Ihrer Kontakte bereits Raven nutzen.";
"pp.contacts.q2.q" = "Werden meine Kontakte auf Ravens Server hochgeladen?";
"pp.contacts.q2.a" = "Telefonnummern werden gesendet, um registrierte Benutzer abzugleichen. Wir speichern Ihre vollständige Kontaktliste nicht dauerhaft.";
"pp.contacts.q3.q" = "Wie gleicht Raven Kontakte mit bestehenden Benutzern ab?";
"pp.contacts.q3.a" = "Wir vergleichen Telefonnummern mit unserer Benutzerdatenbank.";
"pp.contacts.q4.q" = "Was passiert, wenn ein Kontakt Raven nicht nutzt?";
"pp.contacts.q4.a" = "Nichts. Sie können sie einladen, wenn Sie möchten.";
"pp.contacts.q5.q" = "Kann ich Raven ohne Kontaktzugriff nutzen?";
"pp.contacts.q5.a" = "Ja. Sie können dies überspringen und Freunde manuell hinzufügen.";

// PP Location
"pp.location.q1.q" = "Erhebt Raven meinen Standort?";
"pp.location.q1.a" = "Bei der Nutzung des lokalen Feeds oder der Standortfreigabe im Chat greifen wir im Vordergrund darauf zu. Wenn Sie Background Mesh Relay aktivieren, nutzt iOS regionale Standortänderungen, um das Bluetooth der App im Hintergrund zu aktivieren. Ihre genauen geografischen Koordinaten werden jedoch im Hintergrund niemals verfolgt, gespeichert oder an unsere Server gesendet.";
"pp.location.q2.q" = "Wann werden Standortdaten verwendet?";
"pp.location.q2.a" = "Der lokale Feed zeigt Beiträge in Ihrer Nähe. Standortfreigabe sendet Ihre Koordinaten an Chat-Empfänger.";
"pp.location.q3.q" = "Was ist der Unterschied zwischen aktuellem Standort und Live-Standort?";
"pp.location.q3.a" = "Aktuell: einmalig. Live: kontinuierliche Aktualisierung für die gewählte Dauer.";
"pp.location.q4.q" = "Wie lange wird der Live-Standort geteilt?";
"pp.location.q4.a" = "15 Minuten, 1 Stunde oder 8 Stunden – Sie wählen.";
"pp.location.q5.q" = "Kann ich die Standortfreigabe deaktivieren?";
"pp.location.q5.a" = "Ja. Verweigern Sie die Berechtigung in den iOS-Einstellungen oder nutzen Sie einfach keine Standortfunktionen.";
"pp.location.q6.q" = "Werden Standortdaten dauerhaft gespeichert?";
"pp.location.q6.a" = "Beiträge mit Standort behalten ungefähre Koordinaten. Live-Standort wird nach Beendigung nicht gespeichert.";

// PP Messaging
"pp.messaging.q1.q" = "Sind Nachrichten Ende-zu-Ende-verschlüsselt?";
"pp.messaging.q1.a" = "Direktnachrichten sind verschlüsselt. Gruppennachrichten und Beiträge werden auf Servern gespeichert.";
"pp.messaging.q2.q" = "Wer kann meine Nachrichten lesen?";
"pp.messaging.q2.a" = "Sie, der Empfänger und möglicherweise Raven, wenn gesetzlich erforderlich. Verschlüsselte DMs können nur Sie und der Empfänger lesen.";
"pp.messaging.q3.q" = "Werden Nachrichten auf Raven-Servern gespeichert?";
"pp.messaging.q3.a" = "Ja, verschlüsselte Nachrichten werden bis zur Zustellung gespeichert, dann in Ihrem Nachrichtenverlauf aufbewahrt.";
"pp.messaging.q4.q" = "Was passiert mit Nachrichten, die über Mesh-Netzwerk gesendet werden?";
"pp.messaging.q4.a" = "Über nahegelegene Geräte weitergeleitet, dann beim Online-Gehen mit Servern synchronisiert.";
"pp.messaging.q5.q" = "Werden gelöschte Nachrichten dauerhaft entfernt?";
"pp.messaging.q5.a" = "\"Für alle löschen\" entfernt von Servern. \"Für mich löschen\" entfernt nur von Ihrem Gerät.";
"pp.messaging.q6.q" = "Kann Raven meine privaten Nachrichten lesen?";
"pp.messaging.q6.a" = "Verschlüsselte DMs: nein. Andere auf Servern gespeicherte Inhalte: technisch möglich, aber wir tun es nicht.";

// PP Posts
"pp.posts.q1.q" = "Wer kann meine Beiträge sehen?";
"pp.posts.q1.a" = "Abhängig von der Einstellung: Öffentlich (alle), Freunde (Ihre Freunde), Lokal (Benutzer in der Nähe).";
"pp.posts.q2.q" = "Wie wird die Sichtbarkeit (Öffentlich, Freunde, Lokal) gehandhabt?";
"pp.posts.q2.a" = "Der Server filtert basierend auf Ihrer Auswahl und dem Standort/Freundschaftsstatus der Betrachter.";
"pp.posts.q3.q" = "Werden Stories nach dem Ablauf gespeichert?";
"pp.posts.q3.a" = "Nach 24 Stunden von Servern gelöscht.";
"pp.posts.q4.q" = "Können Beiträge oder Stories mehr als einmal angesehen werden?";
"pp.posts.q4.a" = "Einmal-ansehen-Stories: nein. Reguläre Inhalte: abhängig von der Einmalansicht-Einstellung.";
"pp.posts.q5.q" = "Werden Aufrufe und Interaktionen verfolgt?";
"pp.posts.q5.a" = "Ja. Story-Aufrufe zeigen, wer zugeschaut hat. Beitrags-Likes/-Kommentare werden aufgezeichnet.";

// PP Mesh
"pp.mesh.q1.q" = "Welche Daten werden über Mesh-Netzwerk geteilt?";
"pp.mesh.q1.a" = "Verschlüsselte Nachrichteninhalte und Empfängerinfo.";
"pp.mesh.q2.q" = "Warum ist Mesh auf reinen Text beschränkt?";
"pp.mesh.q2.a" = "Bluetooth hat begrenzte Bandbreite. Nur kleine Textnachrichten können effizient weitergeleitet werden.";
"pp.mesh.q3.q" = "Sind Mesh-Daten verschlüsselt?";
"pp.mesh.q3.a" = "Ja, gleiche Verschlüsselung wie reguläre Nachrichten.";
"pp.mesh.q4.q" = "Wie verhindert Raven doppelte Inhalte im Mesh?";
"pp.mesh.q4.a" = "Jede Nachricht hat eine eindeutige ID. Duplikate werden ignoriert.";
"pp.mesh.q5.q" = "Was passiert mit Mesh-Daten, wenn die Internetverbindung wiederhergestellt wird?";
"pp.mesh.q5.a" = "In der Warteschlange befindliche Nachrichten werden mit Servern synchronisiert und normal zugestellt.";

// PP Voice
"pp.voice.q1.q" = "Wird Audio in Sprachräumen aufgezeichnet?";
"pp.voice.q1.a" = "Nein. Audio wird nur live gestreamt, nicht aufgezeichnet.";
"pp.voice.q2.q" = "Werden Sprachräume gespeichert oder archiviert?";
"pp.voice.q2.a" = "Nein. Wenn der Raum endet, wird nichts gespeichert.";
"pp.voice.q3.q" = "Wer kann mich hören, wenn ich spreche?";
"pp.voice.q3.a" = "Alle, die sich derzeit im Raum befinden.";
"pp.voice.q4.q" = "Kann ich Sprachräumen anonym beitreten?";
"pp.voice.q4.a" = "Ja. Wenn der Raumgastgeber es erlaubt, können Sie anonym beitreten. Ihnen wird eine zufällige Tieridentität zugewiesen (z.B. 'Happy Fox') und Ihr echter Benutzername und Ihr Profil bleiben vor allen Teilnehmern verborgen.";

// PP Status
"pp.status.q1.q" = "Wie erkennt Raven, ob ich online bin?";
"pp.status.q1.a" = "Basierend auf der App-Aktivität. Grüner Punkt, wenn die App geöffnet und aktiv ist.";
"pp.status.q2.q" = "Was bedeutet \"Zuletzt gesehen\"?";
"pp.status.q2.a" = "Das letzte Mal, als Sie die App geöffnet haben.";
"pp.status.q3.q" = "Kann ich meinen Online-Status verbergen?";
"pp.status.q3.a" = "Ja, in den Datenschutz-Einstellungen. Dann können Sie aber auch den Status anderer nicht sehen.";
"pp.status.q4.q" = "Ist die Aktivitätsverfolgung optional?";
"pp.status.q4.a" = "Online-Status: optional. Basis-Absturzberichte: werden automatisch erfasst.";

// PP Notifications
"pp.notifications.q1.q" = "Welche Daten werden zum Senden von Benachrichtigungen verwendet?";
"pp.notifications.q1.a" = "Ihr Geräte-Token und Benachrichtigungsinhalt (Absendername, Nachrichtenvorschau).";
"pp.notifications.q2.q" = "Liest Raven den Inhalt von Benachrichtigungen?";
"pp.notifications.q2.a" = "Der Server generiert Benachrichtigungen und weiß daher, wer was gesendet hat.";
"pp.notifications.q3.q" = "Kann ich Benachrichtigungen deaktivieren?";
"pp.notifications.q3.a" = "Ja, in den App-Einstellungen oder iOS-Einstellungen.";

// PP Media
"pp.media.q1.q" = "Sind hochgeladene Fotos und Videos verschlüsselt?";
"pp.media.q1.a" = "Beim Hochladen verschlüsselt. Auf Cloud-Servern gespeichert.";
"pp.media.q2.q" = "Wie lange werden Medien gespeichert?";
"pp.media.q2.a" = "Solange der Beitrag oder die Nachricht existiert.";
"pp.media.q3.q" = "Können Medien dauerhaft gelöscht werden?";
"pp.media.q3.a" = "Das Löschen des Beitrags/der Nachricht löscht die Medien von den Servern.";
"pp.media.q4.q" = "Werden Screenshots erkannt oder eingeschränkt?";
"pp.media.q4.a" = "iOS kann Screenshots für Einmal-ansehen-Inhalte blockieren. Wir benachrichtigen den Story-Ersteller, wenn ein Screenshot erkannt wird.";

// PP Security
"pp.security.q1.q" = "Wie schützt Raven Benutzerdaten?";
"pp.security.q1.a" = "HTTPS für alle Verbindungen, verschlüsselter Speicher, sichere Authentifizierung.";
"pp.security.q2.q" = "Werden Daten im Ruhezustand und bei der Übertragung verschlüsselt?";
"pp.security.q2.a" = "Übertragung: ja (TLS). Ruhezustand: abhängig vom Speichertyp.";
"pp.security.q3.q" = "Wie verhindert Raven unbefugten Zugriff?";
"pp.security.q3.a" = "Passwort-/biometrische Anmeldung, optionale App-Sperre, Sitzungsverwaltung.";
"pp.security.q4.q" = "Was passiert bei einer Datenpanne?";
"pp.security.q4.a" = "Wir würden untersuchen, das Problem beheben und betroffene Benutzer gemäß geltendem Recht benachrichtigen.";

// PP Third Parties
"pp.thirdparty.q1.q" = "Teilt Raven Daten mit Dritten?";
"pp.thirdparty.q1.a" = "Apple (Push-Benachrichtigungen), Google (Anmeldung, KI-Funktionen), RevenueCat (Abonnementverwaltung) und unser Cloud-Hosting-Anbieter.";
"pp.thirdparty.q2.q" = "Werden Analysen oder Absturzberichte erfasst?";
"pp.thirdparty.q2.a" = "Ja, anonyme Absturzberichte zur Fehlerbehebung.";
"pp.thirdparty.q3.q" = "Werden Werbung oder Tracker verwendet?";
"pp.thirdparty.q3.a" = "Keine Werbung. Keine Tracker von Drittanbietern.";
"pp.thirdparty.q4.q" = "Verkauft Raven Benutzerdaten?";
"pp.thirdparty.q4.a" = "Nein.";
"pp.thirdparty.q5.q" = "Werden meine Nachrichten oder Beiträge an KI-Anbieter gesendet?";
"pp.thirdparty.q5.a" = "Nur wenn Sie KI-Funktionen explizit verwenden (wie 'Gemini fragen' oder 'Sprachtranskription'). Der jeweilige Beitrag oder die Audiodatei wird sicher an Google zur Verarbeitung gesendet. Ihre privaten Direktnachrichten werden NIEMALS an KI gesendet oder zum Training öffentlicher Modelle verwendet.";

// PP User Rights
"pp.rights.q1.q" = "Kann ich eine Kopie meiner Daten anfordern?";
"pp.rights.q1.a" = "Ja, E-Mail an privacy@raven-messager.com.";
"pp.rights.q2.q" = "Kann ich mein Konto und alle Daten löschen?";
"pp.rights.q2.a" = "Ja, unter Einstellungen > Konto > Konto schließen.";
"pp.rights.q3.q" = "Wie lange dauert die Löschung?";
"pp.rights.q3.a" = "Sofort aus der App. Server-Backups werden innerhalb von 30 Tagen bereinigt.";
"pp.rights.q4.q" = "Was passiert mit meinen Daten nach der Kontolöschung?";
"pp.rights.q4.a" = "Ihre Daten werden gelöscht. Nachrichten, die Sie an andere gesendet haben, bleiben in deren Verlauf.";

// PP Legal
"pp.legal.q1.q" = "Ist Raven DSGVO-konform?";
"pp.legal.q1.a" = "Wir befolgen DSGVO-Prinzipien: Datenminimierung, Benutzereinwilligung, Recht auf Löschung.";
"pp.legal.q2.q" = "Ist Raven konform mit lokalen Datenschutzgesetzen?";
"pp.legal.q2.a" = "Wir versuchen, die geltenden Gesetze in den Regionen einzuhalten, in denen wir tätig sind.";
"pp.legal.q3.q" = "Wie werden Änderungen der Datenschutzrichtlinie kommuniziert?";
"pp.legal.q3.a" = "In-App-Benachrichtigung und aktualisierte Richtlinie in der App.";
"pp.legal.q4.q" = "Wie kann ich Raven bezüglich Datenschutzbedenken kontaktieren?";
"pp.legal.q4.a" = "E-Mail an privacy@raven-messager.com";

