// TOS Sections
"tos.s1.title" = "1. Annahme der Bedingungen";
"tos.s1.content" = "• Mit der Nutzung von Raven stimmen Sie diesen Nutzungsbedingungen zu.\n• Wenn Sie nicht zustimmen, dürfen Sie die App nicht nutzen.\n• Die fortgesetzte Nutzung bedeutet Akzeptanz von Aktualisierungen.";
"tos.s2.title" = "2. Berechtigung";
"tos.s2.content" = "• Sie müssen mindestens 13 (oder 16 je nach Region) Jahre alt sein.\n• Sie bestätigen, dass die von Ihnen bereitgestellten Informationen korrekt sind.\n• Eine Person, ein Konto, sofern nicht ausdrücklich erlaubt.";
"tos.s3.title" = "3. Kontoverantwortung";
"tos.s3.content" = "• Sie sind für Ihre Kontoaktivität verantwortlich.\n• Sie müssen Ihre Anmeldedaten sicher aufbewahren.\n• Raven ist nicht verantwortlich für unbefugten Zugriff durch Fahrlässigkeit des Benutzers.";
"tos.s4.title" = "4. Benutzerinhalte";
"tos.s4.content" = "• Sie besitzen die Inhalte, die Sie erstellen (Nachrichten, Beiträge, Stories).\n• Durch das Posten gewähren Sie Raven eine begrenzte Lizenz zur Anzeige und Verteilung innerhalb der App.\n• Sie sind verantwortlich für das, was Sie teilen.";
"tos.s5.title" = "5. Verbotene Inhalte & Verhaltensweisen";
"tos.s5.content" = "Benutzer dürfen NICHT:\n• Illegale, gewalttätige oder missbräuchliche Inhalte veröffentlichen\n• Andere belästigen, bedrohen oder sich als andere ausgeben\n• Spam, Malware oder Betrug teilen\n• Geistige Eigentumsrechte verletzen\n• Versuchen, die App zurückzuentwickeln\n• Mesh-Netzwerk oder Systemressourcen missbrauchen\n\nRaven kann Inhalte entfernen oder Konten sperren, die gegen diese Regeln verstoßen.";
"tos.s6.title" = "6. Nachrichten & Kommunikation";
"tos.s6.content" = "• Nachrichten können über Internet oder Mesh-Netzwerk zugestellt werden.\n• Mesh-Netzwerk unterstützt nur Textnachrichten.\n• Raven garantiert keine Echtzeit-Zustellung.\n• Gelöschte Nachrichten können dauerhaft entfernt werden.";
"tos.s7.title" = "7. Mesh-Netzwerk-Haftungsausschluss";
"tos.s7.content" = "• Mesh wird ohne Gewähr bereitgestellt und ist von nahegelegenen Geräten abhängig.\n• Raven ist nicht verantwortlich für Nachrichtenverzögerungen, -verlust oder -duplizierung während der Mesh-Übertragung.\n• Mesh ist nicht für die Notfallkommunikation vorgesehen.";
"tos.s8.title" = "8. Beiträge, Stories & Sichtbarkeit";
"tos.s8.content" = "• Die Sichtbarkeit von Inhalten hängt vom gewählten Modus ab (Öffentlich, Freunde, Lokal).\n• Stories können ansichts- oder zeitbegrenzt sein.\n• Raven garantiert keine Sichtbarkeitsreichweite oder Engagement.";
"tos.s9.title" = "9. Sprachräume";
"tos.s9.content" = "• Sprachräume sind nur live, sofern nicht anders angegeben.\n• Raven zeichnet Räume standardmäßig nicht auf.\n• Moderatoren können Benutzer moderieren, stummschalten oder entfernen.";
"tos.s10.title" = "10. Online-Status & Präsenz";
"tos.s10.content" = "• Der Online-Status ist ungefähr.\n• Raven garantiert keine Genauigkeit der Anzeigen \"online\" oder \"zuletzt gesehen\".\n• Benutzer können die Sichtbarkeit über Einstellungen steuern.";
"tos.s11.title" = "11. Medien-Uploads";
"tos.s11.content" = "• Hochgeladene Medien müssen den Inhaltsregeln entsprechen.\n• Raven kann Medien zur Leistungsoptimierung komprimieren oder verarbeiten.\n• Raven ist nicht verantwortlich für Datenverlust durch Geräte- oder Netzwerkfehler.";
"tos.s12.title" = "12. Benachrichtigungen";
"tos.s12.content" = "• Benachrichtigungen werden als Annehmlichkeit bereitgestellt.\n• Raven ist nicht verantwortlich für verpasste Benachrichtigungen.\n• Benutzer steuern die Benachrichtigungseinstellungen.";
"tos.s13.title" = "13. Kontosperrung & -kündigung";
"tos.s13.content" = "Raven kann:\n• Konten bei Verstößen sperren oder kündigen\n• Inhalte ohne Vorankündigung entfernen\n• Funktionen bei erkanntem Missbrauch einschränken\n\nBenutzer können:\n• Ihr Konto jederzeit löschen\n• Den Zugriff auf gespeicherte Inhalte bei Löschung verlieren";
"tos.s14.title" = "14. Geistiges Eigentum";
"tos.s14.content" = "• Raven, sein Logo, UI und Code sind Eigentum von Raven.\n• Sie dürfen die App nicht kopieren, modifizieren oder weiterverbreiten.\n• Benutzerinhalte bleiben Eigentum des Benutzers.";
"tos.s15.title" = "15. Haftungsbeschränkung";
"tos.s15.content" = "• Raven wird \"wie besehen\" bereitgestellt.\n• Raven haftet nicht für:\n  - Datenverlust\n  - Verpasste Nachrichten\n  - Benutzergenerierte Inhalte\n  - Netzwerk- oder Mesh-Fehler\n• Die Nutzung erfolgt auf eigene Gefahr.";
"tos.s16.title" = "16. Freistellung";
"tos.s16.content" = "Sie erklären sich bereit, Raven von Ansprüchen freizustellen, die verursacht werden durch:\n• Ihre Inhalte\n• Ihren Missbrauch der App\n• Ihre Verletzung von Gesetzen oder diesen Bedingungen";
"tos.s17.title" = "17. Änderungen der Bedingungen";
"tos.s17.content" = "• Raven kann die Bedingungen jederzeit aktualisieren.\n• Die fortgesetzte Nutzung bedeutet Akzeptanz der Änderungen.\n• Wesentliche Änderungen können in der App kommuniziert werden.";
"tos.s18.title" = "18. Anwendbares Recht";
"tos.s18.content" = "• Diese Bedingungen unterliegen den geltenden lokalen und internationalen Gesetzen.\n• Streitigkeiten werden unter der Zuständigkeit von Raven gelöst.";
"tos.s19.title" = "19. Kontakt";
"tos.s19.content" = "Für rechtliche oder Support-Anfragen:\n• E-Mail: privacy@raven-messager.com\n• In-App-Support-Bereich";

// FAQ
"faq.title" = "FAQ";
"faq.q1" = "Was ist Raven und was für eine App ist es?";
"faq.a1" = "Raven ist eine sichere Social-Messaging-App, die Funktionen eines Messengers und sozialen Netzwerks kombiniert. Sie umfasst Beiträge, Stories, Sprachräume und Mesh-Netzwerk für Offline-Kommunikation.";
"faq.q2" = "Was ist der Unterschied zwischen Öffentlichen, Freunde- und Lokalen Beiträgen?";
"faq.a2" = "Öffentliche Beiträge sind für alle sichtbar. Freunde-Beiträge sind nur für Ihre Freunde sichtbar. Lokale Beiträge erscheinen Benutzern in Ihrer geografischen Umgebung basierend auf dem Standort.";
"faq.q3" = "Wie funktioniert die App ohne Internetverbindung?";
"faq.a3" = "Raven nutzt Mesh-Netzwerk über Bluetooth, um Nachrichten über nahegelegene Raven-Benutzer zu senden und zu empfangen, auch ohne Internet. Nachrichten springen zwischen Geräten, bis sie das Ziel erreichen.";
"faq.q4" = "Was ist Mesh-Netzwerk und wann wird es verwendet?";
"faq.a4" = "Mesh-Netzwerk erstellt ein Peer-to-Peer-Netzwerk über Bluetooth. Es wird automatisch verwendet, wenn Sie keine Internetverbindung haben, sodass Nachrichten über andere Raven-Benutzer in der Nähe weitergeleitet werden.";
"faq.q5" = "Warum können nur Textnachrichten über Mesh gesendet werden?";
"faq.a5" = "Bluetooth hat begrenzte Bandbreite, daher können nur kleine Textnachrichten effizient übertragen werden. Fotos und Videos erfordern zu viel Daten für Mesh-Weiterleitung.";
"faq.q6" = "Werden Nachrichten und Beiträge gespeichert, wenn ich offline bin?";
"faq.a6" = "Ja, alle Nachrichten und Beiträge werden lokal auf Ihrem Gerät gespeichert. Sobald Sie sich wieder mit dem Internet verbinden, synchronisieren sie sich automatisch mit dem Server.";
"faq.q7" = "Was passiert mit Mesh-Daten, sobald das Gerät wieder online ist?";
"faq.a7" = "Bei erneuter Verbindung werden ausstehende Mesh-Nachrichten mit dem Server synchronisiert und normal zugestellt. Die Mesh-Warteschlange wird geleert, sobald die Zustellung bestätigt ist.";
"faq.q8" = "Wie funktionieren Stories in Raven?";
"faq.a8" = "Stories sind Fotos oder Videos, die nach 24 Stunden verschwinden. Sie können sie mit allen (Lokal) oder nur Ihren Freunden teilen. Betrachter können reagieren und antworten.";
"faq.q9" = "Warum sind manche Stories nur einmal ansehbar?";
"faq.a9" = "Story-Ersteller können den Modus \"Einmal ansehen\" zum Datenschutz aktivieren. Nachdem die Story geschlossen wurde, kann sie nicht mehr angesehen werden, um sensible Inhalte zu schützen.";
"faq.q10" = "Kann der Story-Ersteller sehen, wer seine Story angesehen hat?";
"faq.a10" = "Ja, Story-Ersteller können eine Liste aller sehen, die ihre Story angesehen haben, einschließlich der Ansichtszeit und Reaktionen.";
"faq.q11" = "Warum ist der Screenshot für manche Stories deaktiviert?";
"faq.a11" = "Ersteller können Screenshots deaktivieren, um zu verhindern, dass ihre Inhalte ohne Erlaubnis gespeichert werden. Dies ist eine Datenschutzfunktion für sensible Stories.";
"faq.q12" = "Was sind Sprachräume?";
"faq.a12" = "Sprachräume sind Live-Audio-Chat-Bereiche, in denen mehrere Benutzer in Echtzeit sprechen können. Sie funktionieren wie Live-Podcast-Gespräche, denen jeder beitreten kann.";
"faq.q13" = "Wer kann einen Sprachraum erstellen?";
"faq.a13" = "Jeder verifizierte Raven-Benutzer kann einen Sprachraum erstellen. Der Ersteller wird zum Moderator mit voller Kontrolle über den Raum.";
"faq.q14" = "Was ist der Unterschied zwischen öffentlichen und Freunde-Sprachräumen?";
"faq.a14" = "Öffentliche Räume erscheinen im lokalen Feed und jeder kann beitreten. Freunde-Räume sind nur auf Einladung und nur für Ihre Freunde sichtbar.";
"faq.q15" = "Wie können Benutzer einem Sprachraum beitreten?";
"faq.a15" = "Tippen Sie auf eine Raumkarte im Feed oder auf einen Raumeinladungslink. Sie treten als Zuhörer bei und können mit der Funktion \"Hand heben\" um Sprechrecht bitten.";
"faq.q16" = "Was macht die Funktion \"Hand heben\"?";
"faq.a16" = "\"Hand heben\" benachrichtigt den Moderator, dass Sie sprechen möchten. Der Moderator kann Sie dann vom Zuhörer zum Sprecher befördern.";
"faq.q17" = "Kann der Raum-Moderator Benutzer stummschalten oder entfernen?";
"faq.a17" = "Ja, Moderatoren können einzelne Sprecher stummschalten, das Sprechrecht entziehen oder sie aus dem Raum werfen.";
"faq.q18" = "Warum ist die Kamera in Sprachräumen deaktiviert?";
"faq.a18" = "Sprachräume sind designbedingt nur für Audio, um die Bandbreitennutzung zu reduzieren und den Fokus auf das Gespräch statt auf Video zu legen.";
"faq.q19" = "Wie funktioniert der Online-/Zuletzt-gesehen-Status?";
"faq.a19" = "Ihr Online-Status zeigt einen grünen Punkt, wenn aktiv. Zuletzt gesehen zeigt das letzte Mal, als Sie Raven offline verwendet haben.";
"faq.q20" = "Kann ich meinen Online-Status verbergen?";
"faq.a20" = "Ja, gehen Sie zu Einstellungen > Datenschutz, um den Online-Status zu deaktivieren. Hinweis: Wenn Sie Ihren Status verbergen, können Sie den Status anderer auch nicht sehen.";
"faq.q21" = "Wie funktioniert die Standortfreigabe?";
"faq.a21" = "Sie können Ihren aktuellen Standort oder Live-Standort in jedem Chat teilen. Empfänger sehen Ihre Position auf einer Karte.";
"faq.q22" = "Was ist der Unterschied zwischen aktuellem Standort und Live-Standort?";
"faq.a22" = "Aktueller Standort ist eine einmalige Momentaufnahme. Live-Standort aktualisiert Ihre Position kontinuierlich für eine festgelegte Dauer.";
"faq.q23" = "Wie lange dauert der Live-Standort?";
"faq.a23" = "Sie können 15 Minuten, 1 Stunde oder 8 Stunden wählen. Sie können die Freigabe jederzeit vor Ablauf der Dauer beenden.";
"faq.q24" = "Erfordert die Standortfreigabe Systemberechtigungen?";
"faq.a24" = "Ja, Sie müssen die Standortberechtigung erteilen, wenn Sie dazu aufgefordert werden. Raven greift nur auf den Standort zu, wenn Sie sich ausdrücklich entscheiden, ihn zu teilen.";
"faq.q25" = "Wie kann ich Nachrichten löschen?";
"faq.a25" = "Halten Sie eine Nachricht gedrückt und tippen Sie auf Löschen. Sie können für sich selbst löschen oder für alle löschen, wenn es Ihre Nachricht ist.";
"faq.q26" = "Wird die Nachricht nur für mich oder auch für den anderen Benutzer gelöscht?";
"faq.a26" = "Beim Löschen Ihrer eigenen Nachrichten können Sie \"Für alle löschen\" wählen, um sie von allen Geräten zu entfernen.";
"faq.q27" = "Warum erscheinen manche Nachrichten nach der Neuinstallation als ungelesen?";
"faq.a27" = "Lesebestätigungen werden lokal gespeichert. Nach der Neuinstallation lädt die App Nachrichten neu herunter, hat aber möglicherweise den vorherigen Lesestatus nicht.";
"faq.q28" = "Warum erscheint eine neue Nachricht manchmal nicht in der Chat-Liste?";
"faq.a28" = "Ziehen Sie nach unten, um die Chat-Liste zu aktualisieren. Bei Mesh kann es dauern, bis Nachrichten über andere Geräte weitergeleitet werden.";
"faq.q29" = "Wie erstelle ich eine Gruppe?";
"faq.a29" = "Tippen Sie in Nachrichten auf Neue Gruppe, wählen Sie Mitglieder aus, fügen Sie einen Gruppennamen und ein optionales Foto hinzu und tippen Sie dann auf Erstellen.";
"faq.q30" = "Warum wird der Gruppenname oder Avatar manchmal falsch angezeigt?";
"faq.a30" = "Dies kann durch Synchronisierungsverzögerungen passieren. Ziehen Sie zum Aktualisieren oder warten Sie einen Moment, bis die neuesten Gruppeninfos geladen sind.";
"faq.q31" = "Warum erscheint eine neu erstellte Gruppe auf meinem Telefon, aber nicht bei anderen?";
"faq.a31" = "Die Gruppenerstellung wird über Push-Benachrichtigung synchronisiert. Mitglieder sehen sie, wenn sie die App öffnen oder eine Nachricht erhalten.";
"faq.q32" = "Wie erkennt Raven, welche meiner Kontakte die App nutzen?";
"faq.a32" = "Mit Ihrer Erlaubnis gleicht Raven Telefonnummern mit registrierten Benutzern ab. Dies geschieht sicher, ohne Kontaktdetails offenzulegen.";
"faq.q33" = "Warum fordert die App Zugriff auf meine Kontakte?";
"faq.a33" = "Um Ihnen zu helfen, Freunde zu finden, die bereits auf Raven sind. Kontaktzugriff ist optional und Sie können ihn ablehnen.";
"faq.q34" = "Was passiert, wenn ein Kontakt Raven nicht installiert hat?";
"faq.a34" = "Sie können sie über die Einladungsfunktion einladen, die einen Freigabelink mit einem App-Download-Link sendet.";
"faq.q35" = "Wie funktioniert die Einladungsfunktion?";
"faq.a35" = "Tippen Sie bei einem Kontakt auf Einladen, um einen Download-Link per E-Mail oder einer anderen App zu teilen. Sie werden als Freund hinzugefügt, wenn sie beitreten.";
"faq.q36" = "Warum erscheinen Benachrichtigungen manchmal nicht auf dem iPhone?";
"faq.a36" = "Überprüfen Sie Einstellungen > Benachrichtigungen, ob Raven die Berechtigung hat. Stellen Sie auch sicher, dass \"Nicht stören\" aus ist und Benachrichtigungen nicht stumm geschaltet sind.";
"faq.q37" = "Welche Arten von Benachrichtigungen sendet Raven?";
"faq.a37" = "Nachrichten, Freundschaftsanfragen, Beitrags-Likes/-Kommentare, Story-Aufrufe und Sprachraum-Einladungen. Jede kann separat angepasst werden.";
"faq.q38" = "Kann ich meine Benachrichtigungseinstellungen anpassen?";
"faq.a38" = "Ja, gehen Sie zu Einstellungen > Benachrichtigungen, um bestimmte Benachrichtigungstypen und Töne zu aktivieren/deaktivieren.";
"faq.q39" = "Wie schützt Raven die Privatsphäre der Benutzer?";
"faq.a39" = "Alle Nachrichten sind Ende-zu-Ende-verschlüsselt. Wir verkaufen keine Daten, minimieren die Erfassung und geben Ihnen die Kontrolle darüber, was Sie teilen.";
"faq.q40" = "Sind meine Daten verschlüsselt?";
"faq.a40" = "Ja, alle Nachrichten verwenden Ende-zu-Ende-Verschlüsselung. Nur Sie und der Empfänger können sie lesen. Selbst Raven kann nicht auf den Nachrichteninhalt zugreifen.";
"faq.q41" = "Wie kann ich einen Benutzer oder Inhalt melden?";
"faq.a41" = "Tippen Sie auf die drei Punkte (...) bei einem Beitrag, Profil oder einer Nachricht und wählen Sie Melden. Wählen Sie die Art des Verstoßes und senden Sie ab.";
"faq.q42" = "Wie kann ich einen anderen Benutzer blockieren?";
"faq.a42" = "Gehen Sie zu dessen Profil, tippen Sie auf die drei Punkte und wählen Sie Blockieren. Blockierte Benutzer können Ihnen keine Nachrichten senden und Ihre Beiträge nicht sehen.";
"faq.q43" = "Wie viele Fotos können in einem Beitrag enthalten sein?";
"faq.a43" = "Derzeit unterstützt jeder Beitrag ein Foto. Multi-Foto-Beiträge werden möglicherweise in zukünftigen Updates unterstützt.";
"faq.q44" = "Warum werden mehrere Fotos als ein Beitrag statt als separate Beiträge angezeigt?";
"faq.a44" = "Um Ihren Feed sauber und organisiert zu halten, werden zusammengehörige Fotos in einem einzigen Karussell-Beitrag gruppiert.";
"faq.q45" = "Was bedeutet das Label \"Per Mesh gesendet\"?";
"faq.a45" = "Dies zeigt an, dass die Nachricht über das Bluetooth-Mesh-Netzwerk gesendet wurde, weil Sie zu diesem Zeitpunkt keine Internetverbindung hatten.";
"faq.q46" = "Können Beiträge oder Stories nur für Freunde eingeschränkt werden?";
"faq.a46" = "Ja, wählen Sie beim Erstellen eines Beitrags oder einer Story \"Freunde\" als Zielgruppe, um die Sichtbarkeit auf Ihre Freunde zu beschränken.";
"faq.q47" = "Warum kann ich einen Beitrag oder eine Story nicht erneut ansehen, nachdem ich sie gesehen habe?";
"faq.a47" = "Manche Inhalte sind designbedingt \"Einmalansicht\". Einmal angesehen, erscheinen sie nicht mehr in Ihrem Feed, um frische Inhalte zu zeigen.";
"faq.q48" = "Können Beiträge oder Stories für später gespeichert werden?";
"faq.a48" = "Stories mit \"Einmal ansehen\" können nicht gespeichert werden. Reguläre Beiträge können durch Tippen auf das Speichern-Symbol als Lesezeichen gesetzt werden.";
"faq.q49" = "Warum erscheint der Anmeldebildschirm kurz beim erneuten Öffnen der App?";
"faq.a49" = "Dies ist eine kurze Authentifizierungsprüfung. Wenn es anhält, versuchen Sie, die App zu schließen und erneut zu öffnen, oder installieren Sie sie bei Bedarf neu.";
"faq.q50" = "Wo kann ich Sprache, Datenschutz und Benachrichtigungseinstellungen ändern?";
"faq.a50" = "Gehen Sie zu Konto > Einstellungen. Sie finden Sprache, Datenschutz, Benachrichtigungen und andere Optionen im Bereich Allgemein.";
"faq.q51" = "Was ist RAVEN+?";
"faq.a51" = "RAVEN+ ist unser Premium-Abonnement, das 2GB Datei-Uploads, 10-Minuten-Sprachnachrichten, unbegrenzte KI-Funktionen, Ghost Mode und VIP-Mesh-Routing-Priorität freischaltet.";
"faq.q52" = "Was ist der Ghost Mode?";
"faq.a52" = "Eine exklusive RAVEN+-Funktion, mit der Sie Nachrichten lesen können, ohne eine Lesebestätigung (blaues Doppelhäkchen) an den Absender zu senden.";
"faq.q53" = "Gibt es Grenzen bei KI-Funktionen?";
"faq.a53" = "Kostenlose Nutzer können 3 Sprachnachrichten transkribieren und Gemini 5 Fragen pro Tag stellen. RAVEN+-Abonnenten haben unbegrenzten Zugang.";
"faq.q54" = "Wie verwalte ich mein Abonnement?";
"faq.a54" = "Abonnements werden sicher von Apple verwaltet. Sie können jederzeit über iPhone-Einstellungen > Apple-ID > Abonnements kündigen.";

