// PP Account
"pp.account.q1.q" = "Какая информация об аккаунте хранится?";
"pp.account.q1.a" = "Имя пользователя, email, информация профиля и токены аутентификации.";
"pp.account.q2.q" = "Мой email обязателен или опционален?";
"pp.account.q2.a" = "Email обязателен. Вы также можете войти через Apple ID или Google аккаунт.";
"pp.account.q3.q" = "Мой email верифицирован и хранится безопасно?";
"pp.account.q3.a" = "Да, верифицирован при регистрации. Хранится в базе данных со стандартными мерами безопасности.";
"pp.account.q4.q" = "Могу ли я изменить или удалить информацию аккаунта?";
"pp.account.q4.a" = "Да. Редактируйте профиль в Настройках. Удаление аккаунта навсегда стирает все данные.";
"pp.account.q5.q" = "Что происходит с моим удостоверением и селфи при Верификации?";
"pp.account.q5.a" = "При подаче заявки на значок верификации ваше удостоверение личности и селфи передаются безопасно исключительно для подтверждения личности. Эти документы окончательно удаляются с наших серверов сразу после завершения процесса проверки. Мы не храним ваше удостоверение или биометрические данные.";

// PP Contacts
"pp.contacts.q1.q" = "Зачем Raven запрашивает доступ к контактам?";
"pp.contacts.q1.a" = "Чтобы показать, кто из ваших контактов уже использует Raven.";
"pp.contacts.q2.q" = "Загружаются ли мои контакты на серверы Raven?";
"pp.contacts.q2.a" = "Номера телефонов отправляются для сопоставления с зарегистрированными пользователями. Мы не храним полный список контактов.";
"pp.contacts.q3.q" = "Как Raven сопоставляет контакты с существующими пользователями?";
"pp.contacts.q3.a" = "Мы сравниваем номера телефонов с базой пользователей.";
"pp.contacts.q4.q" = "Что произойдёт, если контакт не использует Raven?";
"pp.contacts.q4.a" = "Ничего. Вы можете пригласить их, если хотите.";
"pp.contacts.q5.q" = "Можно ли использовать Raven без доступа к контактам?";
"pp.contacts.q5.a" = "Да. Можете пропустить этот шаг и добавлять друзей вручную.";

// PP Location
"pp.location.q1.q" = "Собирает ли Raven моё местоположение?";
"pp.location.q1.a" = "При использовании локальной ленты или отправки местоположения в чате мы получаем доступ в активном режиме. Если вы включите Background Mesh Relay, iOS использует региональные изменения местоположения для активации Bluetooth приложения в фоновом режиме, но ваши точные географические координаты никогда не отслеживаются, не сохраняются и не отправляются на наши серверы в фоновом режиме.";
"pp.location.q2.q" = "Когда используются данные о местоположении?";
"pp.location.q2.a" = "Локальная лента показывает посты рядом с вами. Отправка местоположения передаёт ваши координаты получателю чата.";
"pp.location.q3.q" = "В чём разница между текущим и живым местоположением?";
"pp.location.q3.a" = "Текущее: одноразовое. Живое: непрерывное обновление на выбранный период.";
"pp.location.q4.q" = "Как долго передаётся живое местоположение?";
"pp.location.q4.a" = "15 минут, 1 час или 8 часов — вы выбираете.";
"pp.location.q5.q" = "Могу ли я отключить передачу местоположения?";
"pp.location.q5.a" = "Да. Откажите в разрешении в Настройках iOS или просто не используйте функции геолокации.";
"pp.location.q6.q" = "Хранятся ли данные о местоположении постоянно?";
"pp.location.q6.a" = "Посты с геолокацией сохраняют приблизительные координаты. Живое местоположение не сохраняется после завершения.";

// PP Messaging
"pp.messaging.q1.q" = "Сообщения зашифрованы сквозным шифрованием?";
"pp.messaging.q1.a" = "Личные сообщения зашифрованы. Групповые сообщения и посты хранятся на серверах.";
"pp.messaging.q2.q" = "Кто может читать мои сообщения?";
"pp.messaging.q2.a" = "Вы, получатель и, при требовании закона, Raven. Зашифрованные ЛС могут читать только вы и получатель.";
"pp.messaging.q3.q" = "Хранятся ли сообщения на серверах Raven?";
"pp.messaging.q3.a" = "Да, зашифрованные сообщения хранятся до доставки, затем в истории сообщений.";
"pp.messaging.q4.q" = "Что происходит с сообщениями, отправленными через mesh-сеть?";
"pp.messaging.q4.a" = "Передаются через ближайшие устройства, затем синхронизируются с серверами при подключении.";
"pp.messaging.q5.q" = "Удалённые сообщения удаляются навсегда?";
"pp.messaging.q5.a" = "«Удалить для всех» удаляет с серверов. «Удалить для себя» удаляет только с вашего устройства.";
"pp.messaging.q6.q" = "Может ли Raven читать мои личные сообщения?";
"pp.messaging.q6.a" = "Зашифрованные ЛС: нет. Другой контент: технически возможно, но мы этого не делаем.";

// PP Posts
"pp.posts.q1.q" = "Кто может видеть мои посты?";
"pp.posts.q1.a" = "Зависит от настройки: Публичный (все), Друзья (ваши друзья), Рядом (пользователи поблизости).";
