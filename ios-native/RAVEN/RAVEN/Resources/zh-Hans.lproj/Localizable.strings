// PP General
"pp.general.q1.q" = "Raven收集哪些个人数据？";
"pp.general.q1.a" = "用户名、邮箱、头像、帖子、消息以及使用本地功能时的位置信息。";
"pp.general.q2.q" = "Raven为什么收集个人数据？";
"pp.general.q2.a" = "为了使应用正常运行。我们需要您的邮箱进行验证，并存储您的消息以便您接收。";
"pp.general.q3.q" = "创建账户需要哪些数据？";
"pp.general.q3.a" = "用于验证的邮箱地址以及用户名。";
"pp.general.q4.q" = "可以不提供某些个人信息使用Raven吗？";
"pp.general.q4.a" = "注册需要邮箱。其他所有信息（简介、照片等）都是可选的。";

// PP Account
"pp.account.q1.q" = "存储了哪些账户信息？";
"pp.account.q1.a" = "用户名、邮箱、个人资料信息和身份验证令牌。";
"pp.account.q2.q" = "邮箱是必填还是可选的？";
"pp.account.q2.a" = "邮箱是必填的。您也可以使用Apple ID或Google账户登录。";
"pp.account.q3.q" = "我的邮箱地址是否已验证并安全存储？";
"pp.account.q3.a" = "是的，注册时已验证。使用标准安全措施存储在数据库中。";
"pp.account.q4.q" = "我可以更改或删除账户信息吗？";
"pp.account.q4.a" = "可以。在设置中编辑资料。删除账户将永久清除所有数据。";
"pp.account.q5.q" = "验证时我的证件和自拍会怎样？";
"pp.account.q5.a" = "申请认证徽章时，您的政府签发证件和自拍照将安全传输，仅用于身份确认。审核完成后，这些文件将立即从我们的服务器永久删除。我们不会存储您的证件或生物识别数据。";

// PP Contacts
"pp.contacts.q1.q" = "Raven为什么请求通讯录权限？";
"pp.contacts.q1.a" = "为了向您显示哪些联系人已在使用Raven。";
"pp.contacts.q2.q" = "我的通讯录会上传到Raven服务器吗？";
"pp.contacts.q2.a" = "电话号码会发送用于匹配注册用户。我们不会永久存储您的完整通讯录。";
"pp.contacts.q3.q" = "Raven如何将联系人与现有用户匹配？";
"pp.contacts.q3.a" = "我们将电话号码与用户数据库进行比对。";
"pp.contacts.q4.q" = "如果联系人没有使用Raven怎么办？";
"pp.contacts.q4.a" = "什么都不会发生。您可以选择邀请他们。";
"pp.contacts.q5.q" = "不授权通讯录可以使用Raven吗？";
"pp.contacts.q5.a" = "可以。您可以跳过此步骤，手动添加好友。";

// PP Location
"pp.location.q1.q" = "Raven会收集我的位置吗？";
"pp.location.q1.a" = "使用附近动态或在聊天中共享位置时，我们在前台访问位置信息。如果您启用了后台Mesh中继，iOS会使用区域位置变化在后台唤醒应用的蓝牙，但您的精确地理坐标在后台期间不会被追踪、存储或发送到我们的服务器。";
"pp.location.q2.q" = "位置数据在何时使用？";
"pp.location.q2.a" = "附近动态显示您身边的帖子。位置共享将您的坐标发送给聊天对象。";
"pp.location.q3.q" = "当前位置和实时位置有什么区别？";
"pp.location.q3.a" = "当前位置：一次性的。实时位置：在选定的时间段内持续更新。";
"pp.location.q4.q" = "实时位置共享持续多长时间？";
"pp.location.q4.a" = "15分钟、1小时或8小时——由您选择。";
"pp.location.q5.q" = "可以关闭位置共享吗？";
"pp.location.q5.a" = "可以。在iOS设置中拒绝权限，或者不使用位置功能。";
"pp.location.q6.q" = "位置数据会被永久存储吗？";
"pp.location.q6.a" = "带位置的帖子保留大致坐标。实时位置在结束后不会存储。";

// PP Messaging
"pp.messaging.q1.q" = "消息是否端到端加密？";
"pp.messaging.q1.a" = "私信已加密。群组消息和帖子存储在服务器上。";
"pp.messaging.q2.q" = "谁可以阅读我的消息？";
"pp.messaging.q2.a" = "您、接收者，以及法律要求时的Raven。加密的私信只有您和接收者可以阅读。";
"pp.messaging.q3.q" = "消息是否存储在Raven服务器上？";
"pp.messaging.q3.a" = "是的，加密消息在发送前存储，然后保留在您的消息历史中。";
"pp.messaging.q4.q" = "通过Mesh网络发送的消息会怎样？";
"pp.messaging.q4.a" = "通过附近设备中继，上线后与服务器同步。";
"pp.messaging.q5.q" = "删除的消息会被永久移除吗？";
"pp.messaging.q5.a" = "「为所有人删除」从服务器删除。「为自己删除」仅从您的设备删除。";
"pp.messaging.q6.q" = "Raven能阅读我的私信吗？";
"pp.messaging.q6.a" = "加密的私信：不能。服务器上存储的其他内容：技术上可能，但我们不会这样做。";

// PP Posts
"pp.posts.q1.q" = "谁可以看到我的帖子？";
"pp.posts.q1.a" = "取决于设置：公开（所有人）、好友（您的好友）、附近（附近的用户）。";
"pp.posts.q2.q" = "可见性（公开、好友、附近）如何处理？";
"pp.posts.q2.a" = "服务器根据您的选择和查看者的位置/好友状态进行过滤。";
"pp.posts.q3.q" = "动态过期后还会保存吗？";
"pp.posts.q3.a" = "24小时后从服务器删除。";
"pp.posts.q4.q" = "帖子或动态可以多次查看吗？";
"pp.posts.q4.a" = "阅后即焚的动态：不能。普通内容：取决于一次性查看设置。";
"pp.posts.q5.q" = "浏览和互动是否被追踪？";
"pp.posts.q5.a" = "是的。动态浏览显示谁看过。帖子的点赞/评论会被记录。";

// PP Mesh
"pp.mesh.q1.q" = "Mesh网络会分享哪些数据？";
"pp.mesh.q1.a" = "加密的消息内容和接收者信息。";
"pp.mesh.q2.q" = "为什么Mesh仅限文本？";
"pp.mesh.q2.a" = "蓝牙带宽有限。只有小型文本消息可以高效传输。";
"pp.mesh.q3.q" = "Mesh数据是否加密？";
"pp.mesh.q3.a" = "是的，与普通消息相同的加密方式。";
"pp.mesh.q4.q" = "Raven如何防止Mesh中的重复内容？";
"pp.mesh.q4.a" = "每条消息都有唯一ID。重复消息会被忽略。";
"pp.mesh.q5.q" = "恢复网络连接后Mesh数据会怎样？";
"pp.mesh.q5.a" = "排队的消息会与服务器同步并正常发送。";

// PP Voice
"pp.voice.q1.q" = "语音房间的音频是否被录制？";
"pp.voice.q1.a" = "不会。音频仅实时传输，不会被录制。";
"pp.voice.q2.q" = "语音房间是否被保存或归档？";
"pp.voice.q2.a" = "不会。房间结束后不保存任何内容。";
"pp.voice.q3.q" = "我说话时谁能听到？";
"pp.voice.q3.a" = "当前在房间内的所有人。";
"pp.voice.q4.q" = "可以匿名加入语音房间吗？";
"pp.voice.q4.a" = "可以。如果房间主持人允许，您可以匿名加入。系统会为您分配一个随机动物身份（例如'Happy Fox'），您的真实用户名和个人资料将对所有参与者隐藏。";

// PP Status
"pp.status.q1.q" = "Raven如何判断我是否在线？";
"pp.status.q1.a" = "根据应用活动。应用打开并活跃时显示绿色圆点。";
"pp.status.q2.q" = "「最后在线」是什么意思？";
"pp.status.q2.a" = "您最后一次打开应用的时间。";
"pp.status.q3.q" = "我可以隐藏在线状态吗？";
