// TOS Sections
"tos.s1.title" = "1. Acceptance of Terms";
"tos.s1.content" = "• By using Raven, you agree to these Terms of Service.\n• If you do not agree, you must not use the app.\n• Continued use means acceptance of updates.";
"tos.s2.title" = "2. Eligibility";
"tos.s2.content" = "• You must be at least 13 (or 16 depending on region) years old.\n• You confirm that the information you provide is accurate.\n• One account per person unless explicitly allowed.";
"tos.s3.title" = "3. Account Responsibility";
"tos.s3.content" = "• You are responsible for your account activity.\n• You must keep your login credentials secure.\n• Raven is not responsible for unauthorized access caused by user negligence.";
"tos.s4.title" = "4. Your Messages and Files";
"tos.s4.content" = "• You retain ownership of messages and files you create.\n• By choosing recipients or an invited private group, you authorize Raven software and the carriers you select only to process and deliver that content.\n• You are responsible for what you send and who you send it to.";
"tos.s5.title" = "5. Prohibited Content & Behavior";
"tos.s5.content" = "Users must NOT:\n• Send or share illegal, violent, or abusive material in conversations\n• Harass, threaten, or impersonate others\n• Share spam, malware, or scams\n• Violate intellectual property rights\n• Attempt to reverse-engineer the app\n• Abuse Mesh networking or system resources\n\nRecipients, device owners, and independently operated carriers may block abusive traffic or access under their own policies; Raven does not operate a global content-removal feed.";
"tos.s6.title" = "6. Messaging & Communication";
"tos.s6.content" = "• Messages may be delivered via internet or Mesh networking.\n• Mesh networking supports text-only messages.\n• Raven does not guarantee real-time delivery.\n• Deleted messages may be permanently removed.";
"tos.s7.title" = "7. Mesh Networking Disclaimer";
"tos.s7.content" = "• Mesh is provided as-is and depends on nearby devices.\n• Raven is not responsible for message delays, loss, or duplication during Mesh transmission.\n• Mesh is not intended for emergency communication.";
"tos.s8.title" = "8. Private Conversations and Visibility";
"tos.s8.content" = "• Raven has no public feed, follower audience, or public publishing mode.\n• Messages are addressed only to selected contacts, linked devices, or members of an invited private group.\n• Recipients may retain or forward what they receive, so choose recipients carefully.";
"tos.s9.title" = "9. Private Calls";
"tos.s9.content" = "• Calls are limited to accepted participants in a private conversation.\n• Raven does not record calls by default.\n• Participants or private-group administrators may mute or remove participants.";
"tos.s10.title" = "10. Online Status & Presence";
"tos.s10.content" = "• Online status is approximate.\n• Raven does not guarantee accuracy of \"online\" or \"last seen\" indicators.\n• Users may control visibility via settings.";
"tos.s11.title" = "11. Media Uploads";
"tos.s11.content" = "• Uploaded media must comply with content rules.\n• Raven may compress or process media for performance.\n• Raven is not responsible for data loss due to device or network failure.";
"tos.s12.title" = "12. Notifications";
"tos.s12.content" = "• Notifications are provided as a convenience.\n• Raven is not responsible for missed notifications.\n• Users control notification preferences.";
"tos.s13.title" = "13. Account Suspension & Termination";
"tos.s13.content" = "Raven may:\n• Suspend or terminate accounts for violations\n• Remove content without prior notice\n• Restrict features if abuse is detected\n\nUsers may:\n• Delete their account at any time\n• Lose access to stored content upon deletion";
"tos.s14.title" = "14. Intellectual Property";
"tos.s14.content" = "• Raven, its logo, UI, and code are Raven's property.\n• You may not copy, modify, or redistribute the app.\n• User content remains owned by the user.";
"tos.s15.title" = "15. Limitation of Liability";
"tos.s15.content" = "• Raven is provided \"as is\".\n• Raven is not liable for:\n  - Data loss\n  - Missed messages\n  - User-generated content\n  - Network or Mesh failures\n• Use is at your own risk.";
"tos.s16.title" = "16. Indemnification";
"tos.s16.content" = "You agree to indemnify Raven from claims caused by:\n• Your content\n• Your misuse of the app\n• Your violation of laws or these terms";
"tos.s17.title" = "17. Changes to Terms";
"tos.s17.content" = "• Raven may update Terms at any time.\n• Continued use means acceptance of changes.\n• Major changes may be communicated in-app.";
"tos.s18.title" = "18. Governing Law";
"tos.s18.content" = "• These terms are governed by applicable local and international laws.\n• Disputes will be resolved under Raven's jurisdiction.";
"tos.s19.title" = "19. Contact";
"tos.s19.content" = "For legal or support inquiries:\n• Email: privacy@raven-messager.com\n• In-app support section";

