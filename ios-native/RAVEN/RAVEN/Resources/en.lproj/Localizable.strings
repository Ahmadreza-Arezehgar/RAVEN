// FAQ — A: Getting Started & Account (1–10)
"faq.q1" = "What is RAVEN and how is it different?";
"faq.a1" = "RAVEN is a private, secure messenger with offline mesh networking. Unlike other apps, RAVEN can send messages via Bluetooth when there's no internet — device to device.";
"faq.q2" = "What do I need to create an account?";
"faq.a2" = "A username and an email address. You can also sign in with Apple or Google. Profile photo and bio are optional.";
"faq.q3" = "What happens if I don't provide an email?";
"faq.a3" = "An email address is required for account creation and recovery. You can also use Apple ID or Google Account to sign in.";
"faq.q4" = "How do I delete my account?";
"faq.a4" = "Go to Settings → Account → Delete Account. Your data is permanently removed within 30 days. This action cannot be undone.";
"faq.q5" = "How do I change my username?";
"faq.a5" = "Go to Settings → Profile → Edit. Usernames can be changed once every 30 days. They must be unique and 3–20 characters.";
"faq.q6" = "How do I recover my account?";
"faq.a6" = "Tap 'Forgot Password' on the login screen. We'll send a reset link to your email address.";
"faq.q7" = "Can I have multiple accounts on one phone?";
"faq.a7" = "Not currently. Each device supports one active account. Multi-account support is planned for a future release.";
"faq.q8" = "Does my account work on multiple devices?";
"faq.a8" = "Currently, RAVEN is single-device. Logging in on a new device will sign you out of the previous one. Multi-device sync is in development.";
"faq.q9" = "How do I transfer my data to a new phone?";
"faq.a9" = "Log in with the same credentials on your new device. Messages sync from the server. Local-only data (wallpapers, drafts) does not transfer.";
"faq.q10" = "If I reinstall the app, what do I lose?";
"faq.a10" = "Your account and server-synced messages are restored on login. Local settings (wallpapers, mute preferences, drafts) are reset.";

// FAQ — B: Messaging (11–20)
"faq.q11" = "Are messages end-to-end encrypted?";
"faq.a11" = "Messages use transport encryption (TLS) to and from the server. Full end-to-end encryption is in active development and will be rolled out soon.";
"faq.q12" = "Are messages stored on the server or only on my device?";
"faq.a12" = "Messages are stored on both. The server stores them for delivery sync, and your device caches them locally in an encrypted database for offline access.";
"faq.q13" = "What are the limits for voice, files, and location?";
"faq.a13" = "Voice messages: up to 5 minutes. Files: up to 25 MB. Location: shared as a one-time pin (not live tracking). Image compression is automatic.";
"faq.q14" = "How do read receipts (seen/delivered) work?";
"faq.a14" = "Single check = sent. Double check = delivered to device. Blue checks = read by recipient. You can disable read receipts in Settings → Privacy.";
"faq.q15" = "How does online status work?";
"faq.a15" = "Online status shows when you have the app open. You can hide your status in Settings → Privacy → Show Online Status.";
"faq.q16" = "Why do I sometimes get logged out when internet is unstable?";
"faq.a16" = "This was a known bug where network errors were incorrectly treated as auth failures. It has been fixed — the app now retries silently without logging out.";
"faq.q17" = "Why do some messages send but don't update in the chat?";
"faq.a17" = "This can happen during brief network drops. Pull down to refresh the chat, or the message status will auto-update within a few seconds.";
"faq.q18" = "When do messages show as Delivered vs Seen?";
"faq.a18" = "Delivered = the recipient's device received it. Seen = the recipient opened the chat and the message was on screen. Both require an active connection.";
"faq.q19" = "How do I mute a chat?";
"faq.a19" = "Swipe left on the conversation in the Messages list and tap the bell icon. You can choose: 1 hour, 8 hours, 24 hours, 1 week, or permanently.";
"faq.q20" = "How do I block or report someone?";
"faq.a20" = "Open their profile → tap the three-dot menu → Block or Report. Blocking prevents all contact. Reports are reviewed by our moderation team.";

// FAQ — C: Mesh & Offline (new mesh expectation + 21–35)
"faq.mesh_simple.q" = "How does the Mesh network work in simple terms?";
"faq.mesh_simple.a" = "Imagine passing a paper note in class. Your message hops from one nearby phone to another via Bluetooth until it reaches your friend — no internet needed. Each phone in between just passes it along without reading it.";
"faq.mesh_limits.q" = "What are the limitations of the Mesh network?";
"faq.mesh_limits.a" = "Mesh is not instant — messages may take minutes to arrive depending on how many hops are needed. It's text-only (no photos or files), works within Bluetooth range (~30–100m between devices), requires the app to be active, does not support group chats yet, and is NOT designed for emergency communication.";
"faq.q21" = "What is Direct Mesh and when does it activate?";
"faq.a21" = "Direct Mesh uses Bluetooth to send messages to nearby RAVEN users when both devices have no internet. It activates automatically when the server is unreachable.";
"faq.q22" = "What is Bridge mode?";
"faq.a22" = "When a device has both Bluetooth and internet, it acts as a Bridge — relaying messages from offline users to the server. This happens automatically and transparently.";
"faq.q23" = "How does store-and-forward work?";
"faq.a23" = "If the recipient is out of Bluetooth range, nearby devices can carry the message and forward it when they come in range. Messages hop between devices until delivered.";
"faq.q24" = "How long does a message stay in the mesh?";
"faq.a24" = "Messages have a TTL (Time to Live) of 24 hours and a maximum of 5 hops. After either limit, the message is discarded to prevent infinite circulation.";
"faq.q25" = "How do you prevent duplicate messages?";
"faq.a25" = "Every message has a unique nonce. Each device maintains a seen-nonce cache and rejects any message it has already processed. The server also deduplicates.";
"faq.q26" = "If a message arrives via both server and mesh, what happens?";
"faq.a26" = "The first copy is accepted. The duplicate is silently discarded using the nonce-based deduplication system. You only see one message.";
"faq.q27" = "If a message arrives via mesh, does the server know?";
"faq.a27" = "When the Bridge device uploads it, the server stores it. If you already received it via mesh, the server copy is deduplicated on your device.";
"faq.q28" = "Are mesh messages encrypted?";
"faq.a28" = "Yes. All mesh payloads are encrypted before transmission. Relay devices only see opaque encrypted data and cannot read the content.";
"faq.q29" = "What are the iOS background limitations for mesh?";
"faq.a29" = "iOS restricts background Bluetooth activity. RAVEN works best when the app is in the foreground. Background mesh is limited to brief windows when iOS allows it.";
"faq.q30" = "Why does relay between three phones sometimes fail?";
"faq.a30" = "Multi-hop relay depends on all intermediate devices being in range and having RAVEN open. iOS background restrictions can interrupt the relay chain.";
"faq.q31" = "Why is Bridge unstable sometimes?";
"faq.a31" = "Bridge reliability depends on Bluetooth signal quality and iOS background execution limits. We continuously improve this with adaptive retry logic.";
"faq.q32" = "What if a phone has internet but Bluetooth is off?";
"faq.a32" = "That phone uses normal server messaging. It won't participate in mesh networking. Other nearby devices with Bluetooth can still mesh with each other.";
"faq.q33" = "Does mesh work for group chats?";
"faq.a33" = "Not yet. Mesh currently supports 1:1 messages only. Group mesh support requires additional routing logic and is planned for a future update.";
"faq.q34" = "How does mesh work for posts?";
"faq.a34" = "Text-only posts can be broadcast via mesh. When a device with internet receives a mesh post, it uploads it to the server as a Bridge.";
"faq.q35" = "Why are only text posts allowed in mesh?";
"faq.a35" = "Images and files are too large for Bluetooth's limited bandwidth. Mesh posts are restricted to text to ensure reliable, fast delivery across hops.";

// FAQ — D: Groups (36–45)
"faq.q36" = "How do I create a group and what's the member limit?";
"faq.a36" = "Tap the group icon in Messages. Add members and set a name. Current limit is 100 members per group.";
"faq.q37" = "What can group admins do?";
"faq.a37" = "Admins can: rename the group, change the photo, add/remove members, promote/demote other admins, generate/reset invite links, and set group visibility.";
"faq.q38" = "How do invite links work?";
"faq.a38" = "Admins can generate a shareable link from Group Settings → Invite. Anyone with the link can join. Admins can reset the link at any time to invalidate old ones.";
"faq.q39" = "What does Public vs Private mean?";
"faq.a39" = "Public groups appear in search results and allow joining via link. Private groups are hidden from search and admins can restrict link-based joining.";
"faq.q40" = "How do I leave a group?";
"faq.a40" = "Open Group Settings → scroll to the bottom → Leave Group. Your past messages remain but you stop receiving new ones.";
"faq.q41" = "How do I kick or promote a member?";
"faq.a41" = "Admins can swipe left on a member in Group Settings to see actions: Set Nickname, Promote to Admin, Demote, or Remove from Group.";
"faq.q42" = "How do I change the group wallpaper?";
"faq.a42" = "Group Settings → Customize → Chat Wallpaper. Choose a preset or pick from your gallery. Wallpaper is saved locally per-user, not synced across members.";
"faq.q43" = "Why does my selected wallpaper not apply?";
"faq.a43" = "Make sure you tap 'Done' after selecting. If the issue persists, try restarting the app. Gallery images are compressed and saved locally.";
"faq.q44" = "Why does the UI glitch after selecting a wallpaper?";
"faq.a44" = "This is a known issue with large gallery images. We compress images to max 1080px, but very large files may cause a brief layout recalculation.";
"faq.q45" = "How does group mute work?";
"faq.a45" = "Tap the bell icon in Group Settings. Choose a mute duration or 'Always'. You can also enable 'Mentions Only' to get notified only when you're mentioned.";

// FAQ — E: Posts & Feed (46–55)
"faq.q46" = "Where are posts stored?";
"faq.a46" = "Posts are stored on our servers and cached locally on your device. Mesh posts are stored temporarily on relay devices until uploaded.";
"faq.q47" = "Why don't old post images load after reinstalling?";
"faq.a47" = "This is a known issue with legacy media URL formats. We've fixed the image pipeline to handle both old and new URL formats correctly.";
"faq.q48" = "What does 'Sent via Mesh' mean on a post?";
"faq.a48" = "It means the post was originally created and broadcast via Bluetooth mesh networking, then uploaded to the server by a Bridge device.";
"faq.q49" = "How do I delete or report a post?";
"faq.a49" = "Tap the three-dot menu on any post. You can delete your own posts or report others'. Reports include the post content and your reason.";
"faq.q50" = "Why does a deleted post still appear in the app?";
"faq.a50" = "There may be a caching delay. Pull down to refresh the feed. If it persists, force-quit and reopen the app to clear the local cache.";
"faq.q51" = "How are reports reviewed?";
"faq.a51" = "Our moderation team reviews all reports manually. We don't use automated content scanning. Action is taken within 24–48 hours.";
"faq.q52" = "Are voice comments supported?";
"faq.a52" = "Voice comments are currently in development. The feature will allow recording and playing back voice replies on posts.";
"faq.q53" = "What content is prohibited?";
"faq.a53" = "Illegal content, harassment, spam, impersonation, and explicit material involving minors. Full details are in our Terms of Service.";
"faq.q54" = "How does post deletion sync across devices?";
"faq.a54" = "When you delete a post, the server marks it as deleted and pushes the update to all connected clients. Cached copies expire within minutes.";
"faq.q55" = "How does image caching work?";
"faq.a55" = "Images are cached locally after first load. The cache is cleared on reinstall or when storage is low. You can manually clear it in Settings.";

// FAQ — F: RAVEN+ & Subscriptions (56–59)
"faq.q56" = "What is RAVEN+?";
"faq.a56" = "RAVEN+ is our premium subscription that unlocks 2GB file uploads, 10-minute voice messages, unlimited AI features, Ghost Mode, and VIP Mesh routing priority.";
"faq.q57" = "What is Ghost Mode?";
"faq.a57" = "An exclusive RAVEN+ feature that lets you read messages without sending a read receipt (blue double-check) to the sender.";
"faq.q58" = "Are there limits on AI features?";
"faq.a58" = "Free users can transcribe 3 voice messages and ask Gemini 5 questions per day. RAVEN+ subscribers have unlimited access.";
"faq.q59" = "How do I manage my subscription?";
"faq.a59" = "Subscriptions are managed securely by Apple. You can cancel anytime via your iPhone Settings → Apple ID → Subscriptions.";

// FAQ — G: Security & Privacy (60–64)
"faq.q60" = "What data do you collect?";
"faq.a60" = "Username, authentication info (email), messages, posts, and optional profile data. We do not collect location continuously, contacts without permission, or any analytics/tracking data.";
"faq.q61" = "Do you share data with third parties?";
"faq.a61" = "No. We do not share, sell, or trade your data with anyone. We have no advertising partners, no analytics SDKs, and no data broker relationships.";
"faq.q62" = "What do your server logs contain?";
"faq.a62" = "Minimal operational logs: request type, timestamp, and response status. IP addresses are not permanently stored. No message content is ever logged.";
"faq.q63" = "How long is data retained?";
"faq.a63" = "Account data: while account is active + 30 days after deletion. Messages: until you delete them. Server logs: 30 days. Mesh relay data: 24 hours maximum.";
"faq.q64" = "How do I request my data be deleted?";
"faq.a64" = "Go to Settings → Account → Delete Account to remove everything. For a data export before deletion, use Settings → Account → Download My Data.";

// FAQ — G2: v1.6 capabilities (May 2026)
"faq.q64a" = "What's the Mesh-to-Internet Gateway (Helper Mode)? Can the gateway read my messages?";
"faq.a64a" = "Helper Mode (opt-in, in Linked Devices settings) lets your online phone act as a cipher-text relay for nearby offline neighbours over Bluetooth. The gateway is cryptographically blind — it sees only a recipient hint, an opaque ciphertext blob, and a per-relay nonce. It cannot read the plaintext, cannot identify the original sender, and cannot see group membership. Token-bucket rate limiting (100 KB burst, 1 KB/s steady per neighbour) prevents abuse. The service deactivates automatically when the phone is hot, low on battery, or fully backgrounded.";
"faq.q64b" = "What is the 180-day identity-key rotation? Will my contacts still recognise me?";
"faq.a64b" = "Every 180 days your identity keypair rotates automatically. Each transition is a cross-signed certificate: BOTH the old key signs the new one, AND the new key signs the old one. A peer who only sees your new key can prove provenance back to the old one (and vice versa). The certificate chain is locally verifiable forward and backward — your contacts keep recognising you without re-adding.";
"faq.q64c" = "Is Sealed Sender shipped? What about OPAQUE PAKE?";
"faq.a64c" = "Yes — both shipped in v1.6. Sealed Sender encrypts the sender identity to the recipient's identity key, so the relay layer learns only 'a message exists for X' — not 'from Y'. OPAQUE PAKE (RFC 9497, first iteration) means the server never receives your password, not even hashed; even a full DB breach reveals zero usable credentials. Full standards-compliant OPAQUE with the server-side OPRF round lands in v1.7.";
"faq.q64d" = "Defence-in-depth: how do double encryption and memory hygiene work in v1.6?";
"faq.a64d" = "Sensitive payloads use a Double-AEAD construction — inner ChaCha20-Poly1305 wrapped in outer AES-256-GCM, with a key-committing HMAC tag. Both ciphers must fall before plaintext leaks. Sensitive byte buffers (chain keys, ratchet roots, in-flight plaintext) live in a 'SecretKey' primitive that is page-locked (mlock) so the OS can't write them to swap, and triple-zeroised on deinit (0x00 / 0xFF / 0x00 — alternation defeats compiler-eliding writes).";

// FAQ — H: Echo, Club & Vault (65–70)
"faq.q65" = "What is Echo?";
"faq.a65" = "Echo is RAVEN's stories feature — short-lived posts (photos, videos, or text) that disappear after 24 hours. You can share moments with friends or the public, and see who viewed your Echo.";
"faq.q66" = "Who can see my Echo?";
"faq.a66" = "You control visibility when creating an Echo: share with Everyone, Friends Only, or a custom list. Viewers can react but only you see the full view list.";
"faq.q67" = "What is Club?";
"faq.a67" = "Club is RAVEN's live audio room feature. You can host or join real-time voice conversations, similar to a podcast or conference call. Audio is live-only and never recorded.";
"faq.q68" = "How do I host or join a Club room?";
"faq.a68" = "Navigate to the Club tab in the Mesh section. Tap '+' to create a new room with a title and optional description. Others can browse and join open rooms. Hosts can mute or remove participants.";
"faq.q69" = "What is the Vault?";
"faq.a69" = "The Vault is your private, encrypted storage space within RAVEN. Save important messages, notes, and bookmarks that only you can access. All Vault data is encrypted with AES-256.";
"faq.q70" = "How secure is the Vault?";
"faq.a70" = "Very secure. Vault data is encrypted at rest using AES-256, transmitted over TLS 1.3, and is only accessible with your account credentials. RAVEN staff cannot access your Vault contents.";

// FAQ — I: Stories, Discovery & More (71–79)
"faq.q71" = "How do Stories work in RAVEN?";
"faq.a71" = "Stories are photos or videos that appear at the top of your feed and disappear after 24 hours. You can set who sees them, enable view-once mode, and see who viewed them.";
"faq.q72" = "What is Discover?";
"faq.a72" = "Discover helps you find new people and content. Browse trending posts, explore nearby users, and find public groups — all from the Discover tab.";
"faq.q73" = "How do QR Codes work in RAVEN?";
"faq.a73" = "Go to Settings → My QR Code to share your profile. Others can scan it to instantly send you a friend request. You can also scan others' codes via the camera icon.";
"faq.q74" = "What are Voice Rooms?";
"faq.a74" = "Voice Rooms are live audio spaces where you can talk with friends or communities in real-time. Rooms can be public or private, and hosts have full moderation control.";
"faq.q75" = "Can I post videos in the Feed?";
"faq.a75" = "Yes! RAVEN supports video posts up to 2 minutes. Videos are compressed for efficient delivery and play inline in the feed. RAVEN+ subscribers can upload longer videos.";
"faq.q76" = "How does Identity Verification work?";
"faq.a76" = "Apply for a verified badge via Settings → Account → Verify Identity. Submit a government-issued ID and a selfie. After review, you receive a verification badge on your profile. Documents are deleted immediately after review.";
"faq.q77" = "What are Data Mules in mesh networking?";
"faq.a77" = "Data Mules are devices that physically carry your encrypted messages from one area to another. If your recipient is far away, a moving device (like someone walking between locations) can automatically carry and deliver your message.";
"faq.q78" = "What are Hashtags and how does trending work?";
"faq.a78" = "Add hashtags (#) to your posts to make them discoverable. Trending hashtags appear on the Discover page based on post volume in the last 24 hours. Tap a hashtag to see all related posts.";
"faq.q79" = "How does the media editor work?";
"faq.a79" = "Before posting, you can edit photos and videos with filters, cropping, text overlays, and stickers. All editing is done locally on your device — no data is sent to our servers until you post.";

