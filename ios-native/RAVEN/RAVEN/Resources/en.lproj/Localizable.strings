// PP — A: General & Transparency (1–10)
"pp.q1" = "What app and organization does this policy apply to?";
"pp.a1" = "This policy applies to RAVEN, developed and operated by the RAVEN team. It covers all versions of the app on all platforms.";
"pp.q2" = "When was this policy last updated?";
"pp.a2" = "This policy was last updated on February 10, 2025. We review and update it regularly.";
"pp.q3" = "How will I be notified of policy changes?";
"pp.a3" = "We notify you via in-app notification and email (if provided) at least 7 days before changes take effect. Major changes require your acknowledgement.";
"pp.q4" = "What age is required to use RAVEN?";
"pp.a4" = "You must be at least 13 years old (or the minimum age in your jurisdiction). We do not knowingly collect data from children under 13.";
"pp.q5" = "Is my data used only to provide the service?";
"pp.a5" = "Yes. We use your data solely to deliver, maintain, and improve RAVEN. We do not use it for advertising, profiling, or any unrelated purpose.";
"pp.q6" = "What data is essential for the service to work?";
"pp.a6" = "Username, authentication credentials (email), and device identifiers are required. Without these, core features like messaging cannot function.";
"pp.q7" = "What data is optional?";
"pp.a7" = "Profile photo, display name, bio, birthday, and contact list sync are all optional. You can use RAVEN fully without providing them.";
"pp.q8" = "Do you sell user data?";
"pp.a8" = "No. We do not sell, rent, or trade your personal data to anyone under any circumstances.";
"pp.q9" = "Do you work with advertisers or data brokers?";
"pp.a9" = "No. RAVEN has no advertising partners, no data brokers, and no third-party tracking SDKs.";
"pp.q10" = "How can I submit a privacy question or complaint?";
"pp.a10" = "Email privacy@raven-messager.com or use the in-app 'Report a Privacy Issue' option at the bottom of this page. We respond within 72 hours.";

// PP — B: Account & Registration (11–21)
"pp.q11" = "What information is collected when I sign up?";
"pp.a11" = "We collect your username, email address, and an optional profile photo. If using social sign-in, we receive your name and email from the provider.";
"pp.q12" = "Do you verify email?";
"pp.a12" = "Yes. We send a verification code (OTP) to confirm ownership. The code expires after 10 minutes and is not stored.";
"pp.q13" = "Can I use RAVEN without an email?";
"pp.a13" = "Users can sign up and log in using a verified email address, Apple ID, or Google Account. Phone number-based registration or authentication is not supported. If users choose email-based registration, email verification is mandatory before account activation.";
"pp.q14" = "How are passwords stored?";
"pp.a14" = "Today: stretched on the server with Argon2id (time=3, memory=64 MiB, parallelism=4) plus a unique salt per user. We never store plaintext passwords and even our team cannot recover yours. Coming v1.6: OPAQUE PAKE first iteration so the server never receives your password at all — not even hashed. If you use OAuth (Google/Apple), no password is stored.";
"pp.q15" = "What data do you get from Google/Apple sign-in?";
"pp.a15" = "Only your name and email address. We do not receive your contacts, photos, or any other data from the OAuth provider.";
"pp.q16" = "Is a profile photo required?";
"pp.a16" = "No. A profile photo is completely optional. If not set, your initial letter is shown instead.";
"pp.q17" = "Why do you collect birthday and where is it used?";
"pp.a17" = "Birthday is optional and used only for age verification. It is never shown to other users unless you choose to display it.";
"pp.q18" = "Can I hide my birthday?";
"pp.a18" = "Yes. By default, birthday is private. You can change visibility in Settings → Privacy.";
"pp.q19" = "Do you create a device fingerprint?";
"pp.a19" = "We generate a random device ID for push notifications and session management. We do not fingerprint your hardware, browser, or installed apps.";
"pp.q20" = "What happens to my data when I delete my account?";
"pp.a20" = "All personal data is permanently deleted within 30 days. Messages you sent in group chats may remain visible to other members but are disassociated from your identity.";
"pp.q21" = "What happens to my ID and selfie during Verification?";
"pp.a21" = "When applying for a verified badge, your government-issued ID and a selfie are transmitted securely for identity confirmation only. These documents are permanently deleted from our servers immediately after the review process is completed. We do not store your ID or biometric data.";

// PP — C: Messages & Chats (22–31)
"pp.q22" = "Are messages end-to-end encrypted?";
"pp.a22" = "Yes — end-to-end. Every 1:1 conversation runs the Signal protocol (X3DH for asynchronous key agreement + Double Ratchet for per-message key rotation), giving you forward secrecy and post-compromise security on internet AND on Bluetooth mesh. Our servers and every relay see only ciphertext we cannot decrypt — even under legal compulsion. Group chats today use per-group AES-256-GCM symmetric keys (rotated when a member is removed); migration to MLS (RFC 9420) is committed for v1.7.";
"pp.q23" = "Who can see my messages?";
"pp.a23" = "Only you and the recipient(s). RAVEN staff cannot read message content. Automated systems do not scan message text.";
"pp.q24" = "How long are messages stored on the server?";
"pp.a24" = "Messages are stored until you delete them. If you delete a message, it is removed from our servers within 24 hours.";
"pp.q25" = "Are messages stored on my device?";
"pp.a25" = "Yes. Messages are cached locally in an encrypted SQLite database for offline access. This data stays on your device only.";
"pp.q26" = "Are messages scanned for spam or safety?";
"pp.a26" = "No. We do not scan, read, or analyze message content. Spam detection relies on metadata patterns (rate, volume), not content.";
"pp.q27" = "Are deleted messages truly deleted?";
"pp.a27" = "Yes. When you delete a message, it is removed from your device immediately and from our servers within 24 hours. We do not keep shadow copies.";
"pp.q28" = "How are media files (photos, voice, files) stored?";
"pp.a28" = "Media is uploaded to our secure cloud storage (encrypted at rest). Files are linked to your account and deleted when you delete the message.";
"pp.q29" = "Do you keep metadata logs?";
"pp.a29" = "We retain minimal metadata (sender, recipient, timestamp) for delivery confirmation. IP addresses are not permanently logged. Metadata is purged after 90 days.";
"pp.q30" = "Can I export my chat data?";
"pp.a30" = "Yes. Go to Settings → Account → Download My Data to export all your messages and media as a ZIP file.";
"pp.q31" = "What happens when I block someone?";
"pp.a31" = "They cannot send you messages, see your online status, or view your profile. Existing messages remain in your history but can be deleted.";

// PP — D: Groups (32–39)
"pp.q32" = "Where is group data stored?";
"pp.a32" = "Group names, member lists, and role assignments are stored on our servers. Group messages follow the same storage policy as direct messages.";
"pp.q33" = "What access do group admins have?";
"pp.a33" = "Admins can: rename the group, change the photo, add/remove members, promote/demote roles, and reset invite links. Admins cannot read private messages.";
"pp.q34" = "Can members download group message history?";
"pp.a34" = "Members can export their own messages via Settings → Download My Data. They cannot bulk-download other members' messages.";
"pp.q35" = "What happens when I leave a group?";
"pp.a35" = "You stop receiving messages. Your past messages remain visible to group members but you can delete them before leaving.";
"pp.q36" = "How are invite links created and do they expire?";
"pp.a36" = "Invite links are generated with a unique random token. They do not expire by default but can be reset by admins, which invalidates the old link.";
"pp.q37" = "Can invite links be revoked?";
"pp.a37" = "Yes. Admins can reset the invite link at any time, which immediately invalidates the previous link.";
"pp.q38" = "What's the difference between public and private groups?";
"pp.a38" = "Public groups appear in search and allow join via link. Private groups are hidden from search and can restrict link joining.";
"pp.q39" = "What data is sent when I report a group?";
"pp.a39" = "Your user ID, the group ID, a reason category, and optional description. Message content is not automatically included in reports.";

// PP — E: Contacts (40–47)
"pp.q40" = "Do you upload my contacts?";
"pp.a40" = "Only if you explicitly enable Contact Sync in Settings. By default, contacts are never uploaded.";
"pp.q41" = "If uploaded, what exactly is sent?";
"pp.a41" = "Contact identifiers are hashed (SHA-256) before upload. We never receive or store raw contact data from your contact list.";
"pp.q42" = "What hashing algorithm and salt do you use?";
"pp.a42" = "SHA-256 with a server-side rotating salt. The salt changes periodically and old hashes are discarded.";
"pp.q43" = "How long are uploaded contacts retained?";
"pp.a43" = "Hashed contacts are retained only while Contact Sync is enabled. They are deleted within 24 hours of disabling sync.";
"pp.q44" = "Can I turn off contact sync?";
"pp.a44" = "Yes. Go to Settings → Privacy → Contact Sync → Off. This is off by default.";
"pp.q45" = "If I turn it off, is previous data deleted?";
"pp.a45" = "Yes. Previously uploaded hashes are deleted from our servers within 24 hours.";
"pp.q46" = "Do you send messages or invitations to my contacts?";
"pp.a46" = "Never. We do not send SMS, emails, or notifications to your contacts without your explicit action.";
"pp.q47" = "Are contacts used for friend suggestions?";
"pp.a47" = "Only if Contact Sync is enabled. Suggestions are based on matched hashes, not raw numbers. You can disable this separately.";

// PP — F: Posts & Feed (48–53)
"pp.q48" = "Are my posts public by default?";
"pp.a48" = "Posts are visible to your followers by default. You can change this per-post or set a global default in Settings → Privacy.";
"pp.q49" = "Are deleted posts truly removed?";
"pp.a49" = "Yes. Deleted posts and their media are removed from our servers within 24 hours. Cached copies on other devices expire naturally.";
"pp.q50" = "Is view count real or estimated?";
"pp.a50" = "View counts are real and based on unique authenticated views. We do not inflate or estimate view numbers.";
"pp.q51" = "Are post texts and hashtags indexed?";
"pp.a51" = "Yes, for search and discovery purposes. This index is used only within RAVEN and is not shared externally.";
"pp.q52" = "Are posts or comments moderated?";
"pp.a52" = "User-reported content is reviewed by our moderation team. We do not use automated content scanning or AI moderation on posts.";
"pp.q53" = "Does Download My Data include posts?";
"pp.a53" = "Yes. Your data export includes all your posts, comments, and associated media files.";

// PP — G: Mesh & Offline (54–59 + mesh.privacy)
"pp.q54" = "What data is exchanged between devices in Mesh mode?";
"pp.a54" = "Encrypted message payloads (opaque to relays), anonymised sender/recipient hashes (not raw user IDs), timestamps, and TTL counters. No profile data, no contact graph, no GPS in the mesh frame itself. NOTE: radio-layer traffic analysis can still reveal which devices are talking on the airwaves; we mitigate today with anonymised hashes + dedup + randomised re-broadcast jitter, and ship constant-rate cover traffic + decoy envelopes in 2026 H2.";
"pp.q55" = "Is content encrypted during Mesh transfer?";
"pp.a55" = "Yes. The same Signal end-to-end protocol that protects internet messages (X3DH + Double Ratchet) protects the mesh path. Relay devices forward bytes they cannot read, modify, or impersonate — every envelope is independently signed (Ed25519) and sealed (AES-256-GCM) by the original sender.";
"pp.q56" = "What is Bridge mode and what does it do?";
"pp.a56" = "A Bridge device relays messages between offline users and the server when it regains connectivity. It acts as a courier, not a reader.";
"pp.q57" = "Can a relay device see my message content?";
"pp.a57" = "No. Messages are encrypted end-to-end for mesh transfer. Relay devices only see opaque encrypted payloads.";
"pp.q58" = "How long do mesh messages live?";
"pp.a58" = "Messages have a TTL (Time to Live) of 24 hours and a maximum of 5 hops. After either limit, the message is discarded.";
"pp.q59" = "How do you prevent duplicate or replay attacks?";
"pp.a59" = "Each message has a unique nonce. Devices maintain a seen-nonce cache to reject duplicates. Expired TTL messages are also rejected.";
"pp.mesh.privacy.q" = "Can other users identify me when my device relays their messages?";
"pp.mesh.privacy.a" = "No. When your device relays messages for others, your identity is never attached to the payload. Relay devices are anonymous couriers — they cannot read the message, and neither the sender nor the recipient knows which device relayed it.";

// PP — H: Third Parties & AI (61–63)
"pp.q61" = "What third-party services does RAVEN use?";
"pp.a61" = "Apple APNs (push wake-up only — never message content); Apple Sign in / Apple Foundation Models / Apple Translation (all on-device); Google Sign-in (optional, only your name + email); Google Gemini (cloud, only when you explicitly use 'Ask Gemini' on a public post — never on DMs); Google Cloud Run (Belgium, EU — hosts our FastAPI relay; only sees ciphertext); RevenueCat (RAVEN+ subscription receipts via StoreKit); LiveKit (real-time audio mixer for Club rooms — never recorded); SQLCipher (on-device DB encryption library). Not used: Crashlytics, Sentry, Mixpanel, Datadog, Firebase Analytics, Facebook SDK, advertising SDK, fingerprinting library — zero analytics SDKs ship in the app binary today.";
"pp.q62" = "Are my messages or posts sent to AI providers?";
"pp.a62" = "Conversation summaries and smart replies run entirely ON-DEVICE (Apple Foundation Models, iOS 26+) — nothing leaves your phone. 'Ask Gemini' on a public post is the only feature that sends content to a cloud AI provider — only the specific post you tap on, only when you trigger it. Your private DMs, group messages, and Bluetooth-mesh traffic are NEVER sent to any AI provider, and your messages are NEVER used to train public models.";
"pp.q63" = "Does RAVEN sell data to advertisers?";
"pp.a63" = "No. RAVEN has no advertising partners, no data brokers, and no third-party tracking SDKs.";

// PP — I: Security & Data Retention (64–65)
"pp.q64" = "How is data encrypted at rest on your servers?";
"pp.a64" = "All data is encrypted at rest using AES-256. Database volumes use full-disk encryption. Backups are encrypted with separate keys.";
"pp.q65" = "How long are logs, IPs, and device metadata retained?";
"pp.a65" = "Server access logs are retained for 30 days for security monitoring. IP addresses are not stored beyond the active session. Device metadata is retained while your account is active and deleted within 30 days of account deletion.";

// PP — J: Echo, Club, Vault & Discovery (66–74)
"pp.section.9" = "Echo, Club, Vault & Discovery";
"pp.q66" = "How is Echo data handled?";
"pp.a66" = "Echoes (24-hour stories) are stored on our servers for the duration they are active. Once expired, they are permanently deleted within 24 hours. View counts and viewer lists are only visible to the creator.";
"pp.q67" = "Is Club audio recorded or stored?";
"pp.a67" = "No. Club (live audio rooms) are fully real-time and ephemeral. Audio is streamed peer-to-peer and is never recorded, stored, or processed on our servers. Once the room ends, no audio data remains.";
"pp.q68" = "What data is stored in the Vault?";
"pp.a68" = "The Vault stores your private notes, saved messages, and bookmarked content. All Vault data is encrypted at rest on our servers using AES-256 and is only accessible with your account credentials.";
"pp.q69" = "How is Vault data encrypted?";
"pp.a69" = "Vault items are encrypted at rest using AES-256 on the server. In transit, all data uses TLS 1.3. Your Vault cannot be accessed by RAVEN staff or any third party.";
"pp.q70" = "What data does Discover collect?";
"pp.a70" = "Discover uses your general location (city-level, never precise GPS) to show nearby users and trending content. Location data is not stored permanently and is refreshed only while the Discover tab is active.";
"pp.q71" = "Does QR Code scanning collect data?";
"pp.a71" = "No. QR codes contain only a user identifier for adding friends. Scanning a QR code does not share your location, contacts, or any other personal data.";
"pp.q72" = "How is identity verification data handled?";
"pp.a72" = "Government-issued ID and selfie photos submitted for verification are transmitted over TLS, reviewed by our team, and permanently deleted immediately after the review is complete. We do not store, share, or use this data for any other purpose.";
"pp.q73" = "What data do Voice Rooms collect?";
"pp.a73" = "Voice Rooms stream audio in real-time and do not record or store any audio data. Room metadata (title, host, participant count) is stored while the room is active and deleted when it ends.";
"pp.q74" = "How are Stories and video posts stored?";
"pp.a74" = "Story media (photos/videos) is stored on our servers while the story is active (24 hours). After expiration, media is permanently deleted. Video posts in the feed follow the same storage policy as image posts — encrypted at rest and deleted when you remove the post.";

