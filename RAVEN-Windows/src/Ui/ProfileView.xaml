<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RAVEN.Windows.Ui.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:RAVEN.Windows.Ui">

    <!--
      Profile (middle pane on the Profile tab). Mirrors `ProfileColumn.swift`:
        - Title
        - Avatar header card (logo-gradient backdrop)
        - Action tiles (Edit profile, Settings, Friend requests, Linked devices, Sign out)
        - Identity card (fingerprint + Ed25519 / X25519 public keys)
        - Mesh diagnostics card (peers / relayed / bridges)
        - Settings (run-on-login, minimise-to-tray, bridge mode)

      The Mac build keeps mesh diagnostics under a separate "Settings"
      sheet; on Windows we surface them inline because the Windows scope
      is "lightweight client + full mesh node" and operators want at-a-
      glance visibility.
    -->
    <ScrollView Background="{StaticResource RavenBg}">
        <StackPanel Padding="0,18,0,32" Spacing="16" MaxWidth="720"
                    HorizontalAlignment="Stretch">

            <TextBlock Text="Profile"
                       FontSize="22" FontWeight="ExtraBold"
                       Foreground="{StaticResource RavenText}"
                       Padding="20,0,20,0"/>

            <!-- Header card: avatar + display name + handle -->
            <Border Margin="20,0" Padding="20" CornerRadius="20"
                    Background="{StaticResource RavenLogoGradientSubtle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32"
                            Background="{StaticResource RavenLogoGradient}">
                        <TextBlock x:Name="AvatarLetter" Text="?"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="DisplayName" Text="Sign in to RAVEN"
                                   FontSize="22" FontWeight="ExtraBold"
                                   Foreground="{StaticResource RavenText}"/>
                        <TextBlock x:Name="HandleLabel" Text="@local"
                                   FontSize="13"
                                   Foreground="{StaticResource RavenText2}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action tiles -->
            <StackPanel Spacing="2" Padding="20,0">
                <Button HorizontalAlignment="Stretch" Padding="16,14" CornerRadius="14"
                        Background="Transparent" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;"
                                  FontSize="16" Foreground="{StaticResource RavenText}"/>
                        <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="Edit profile"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource RavenText}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button HorizontalAlignment="Stretch" Padding="16,14" CornerRadius="14"
                        Background="Transparent" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE713;"
                                  FontSize="16" Foreground="{StaticResource RavenText}"/>
                        <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="Settings"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource RavenText}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button HorizontalAlignment="Stretch" Padding="16,14" CornerRadius="14"
                        Background="Transparent" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE8FA;"
                                  FontSize="16" Foreground="{StaticResource RavenText}"/>
                        <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="Friend requests"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource RavenText}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button HorizontalAlignment="Stretch" Padding="16,14" CornerRadius="14"
                        Background="Transparent" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xED14;"
                                  FontSize="16" Foreground="{StaticResource RavenText}"/>
                        <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="Linked devices"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource RavenText}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button HorizontalAlignment="Stretch" Padding="16,14" CornerRadius="14"
                        Background="Transparent" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xF3B1;"
                                  FontSize="16" Foreground="{StaticResource RavenRedBrush}"/>
                        <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="Sign out"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource RavenRedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Identity card -->
            <Border Margin="20,8,20,0" Padding="20" CornerRadius="16"
                    Background="{StaticResource RavenBgCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Identity" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource RavenText}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fingerprint"
                                   FontSize="13" Foreground="{StaticResource RavenText3}"/>
                        <TextBlock Grid.Column="1" x:Name="FingerprintLabel" Text="—"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource RavenText}"
                                   IsTextSelectionEnabled="True"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ed25519 public key"
                                   FontSize="13" Foreground="{StaticResource RavenText3}"/>
                        <TextBlock Grid.Column="1" x:Name="EdPubLabel" Text="—"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource RavenText2}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="X25519 public key"
                                   FontSize="13" Foreground="{StaticResource RavenText3}"/>
                        <TextBlock Grid.Column="1" x:Name="XPubLabel" Text="—"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource RavenText2}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Mesh diagnostics card -->
            <Border Margin="20,0" Padding="20" CornerRadius="16"
                    Background="{StaticResource RavenBgCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Mesh diagnostics" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource RavenText}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Peers nearby" FontSize="11" Foreground="{StaticResource RavenText3}"/>
                            <TextBlock x:Name="PeersValue" Text="0" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource RavenBrandGradient}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Frames relayed" FontSize="11" Foreground="{StaticResource RavenText3}"/>
                            <TextBlock x:Name="RelayedValue" Text="0" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource RavenText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Bridge uplinks" FontSize="11" Foreground="{StaticResource RavenText3}"/>
                            <TextBlock x:Name="BridgeValue" Text="0" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource RavenText}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="What this device does for the mesh"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource RavenText}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource RavenText2}"
                                   Text="• Acts as a BLE peer for nearby iPhones and Macs"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource RavenText2}"
                                   Text="• Relays encrypted envelopes it can't read (zero-knowledge)"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource RavenText2}"
                                   Text="• Bridges mesh → server when online for offline-pickup recipients"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Mesh / app settings -->
            <Border Margin="20,0" Padding="20" CornerRadius="16"
                    Background="{StaticResource RavenBgCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource RavenText}"/>
                    <ToggleSwitch x:Name="StartOnLogin" Header="Run RAVEN on login"
                                  OffContent="Disabled" OnContent="Enabled"/>
                    <ToggleSwitch x:Name="MinimizeToTray" Header="Minimise to tray on close"
                                  IsOn="True"
                                  OffContent="Quits app on close" OnContent="Keeps mesh alive"/>
                    <ToggleSwitch x:Name="BridgeMode" Header="Act as a bridge for offline peers"
                                  IsOn="True"
                                  OffContent="Disabled" OnContent="Enabled"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollView>
</UserControl>
