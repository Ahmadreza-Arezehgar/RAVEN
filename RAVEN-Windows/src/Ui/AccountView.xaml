<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RAVEN.Windows.Ui.AccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:RAVEN.Windows.Ui">

    <!--
      Account view. Settings + identity + mesh diagnostics.
        - Identity card: fingerprint, public key
        - Mesh status card: peers count, bytes relayed, bridge mode toggle
        - Settings: theme, notifications, sign-out
    -->

    <Border Background="{StaticResource RavenBgCard}"
            BorderBrush="{StaticResource RavenBorder}" BorderThickness="1"
            CornerRadius="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32" Spacing="20" MaxWidth="720">

                <!-- Header -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Account" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource RavenText}"/>
                    <TextBlock Text="Identity, mesh diagnostics, and settings"
                               FontSize="12" Foreground="{StaticResource RavenText3}"/>
                </StackPanel>

                <!-- Identity card -->
                <Border Padding="20" CornerRadius="16"
                        Background="{StaticResource RavenBgCardHover}"
                        BorderBrush="{StaticResource RavenBorder}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="🔑  Identity" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource RavenText}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fingerprint"
                                       FontSize="13" Foreground="{StaticResource RavenText3}"/>
                            <TextBlock Grid.Column="1" x:Name="FingerprintLabel" Text="—"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource RavenText}"
                                       IsTextSelectionEnabled="True"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Ed25519 public key"
                                       FontSize="13" Foreground="{StaticResource RavenText3}"/>
                            <TextBlock Grid.Column="1" x:Name="EdPubLabel" Text="—"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource RavenText2}"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X25519 public key"
                                       FontSize="13" Foreground="{StaticResource RavenText3}"/>
                            <TextBlock Grid.Column="1" x:Name="XPubLabel" Text="—"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource RavenText2}"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mesh diagnostics card -->
                <Border Padding="20" CornerRadius="16"
                        Background="{StaticResource RavenBgCardHover}"
                        BorderBrush="{StaticResource RavenBorder}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="📡  Mesh diagnostics" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource RavenText}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Peers nearby" FontSize="11" Foreground="{StaticResource RavenText3}"/>
                                <TextBlock x:Name="PeersValue" Text="0" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource RavenBrandGradient}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Frames relayed" FontSize="11" Foreground="{StaticResource RavenText3}"/>
                                <TextBlock x:Name="RelayedValue" Text="0" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource RavenText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="Bridge uplinks" FontSize="11" Foreground="{StaticResource RavenText3}"/>
                                <TextBlock x:Name="BridgeValue" Text="0" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource RavenText}"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource RavenBgCard}"
                                BorderBrush="{StaticResource RavenBorder}" BorderThickness="1"
                                CornerRadius="12" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="What this device does for the mesh"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource RavenText}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource RavenText2}"
                                           Text="• Acts as a BLE peer for nearby iPhones and Macs"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource RavenText2}"
                                           Text="• Relays encrypted envelopes it can't read (zero-knowledge)"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource RavenText2}"
                                           Text="• Bridges mesh → server when online for offline-pickup recipients"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Settings card -->
                <Border Padding="20" CornerRadius="16"
                        Background="{StaticResource RavenBgCardHover}"
                        BorderBrush="{StaticResource RavenBorder}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="⚙️  Settings" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource RavenText}"/>

                        <ToggleSwitch x:Name="StartOnLogin" Header="Run RAVEN on login"
                                      OffContent="Disabled" OnContent="Enabled"/>
                        <ToggleSwitch x:Name="MinimizeToTray" Header="Minimise to tray on close"
                                      IsOn="True"
                                      OffContent="Quits app on close" OnContent="Keeps mesh alive"/>
                        <ToggleSwitch x:Name="BridgeMode" Header="Act as a bridge for offline peers"
                                      IsOn="True"
                                      OffContent="Disabled" OnContent="Enabled"/>
                    </StackPanel>
                </Border>

                <!-- Sign-out -->
                <Button HorizontalAlignment="Stretch" Padding="14,12" CornerRadius="14"
                        Background="{StaticResource RavenBgCardHover}"
                        BorderBrush="{StaticResource RavenBorder}" BorderThickness="1"
                        Foreground="{StaticResource RavenPink}">
                    <TextBlock Text="Sign out" FontWeight="SemiBold"/>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
