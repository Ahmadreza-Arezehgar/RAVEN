<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RAVEN.Windows.Ui.ChatThreadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:RAVEN.Windows.Ui">

    <!--
      Chat thread for the right pane on the Messages tab. Mirrors
      `RAVEN-MacApp/RAVEN/Views/Components/ChatThreadView.swift`. Header
      with avatar + name + transport hint, scrolling bubble list, and a
      composer pinned at the bottom. Empty state shown until the
      ShellRouter selects a conversation.
    -->
    <Grid Background="{StaticResource RavenBg}">
        <!-- Empty state (visible until a conversation is selected) -->
        <StackPanel x:Name="EmptyState"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="18" Padding="40">
            <Grid Width="96" Height="96">
                <Ellipse Fill="{StaticResource RavenLogoGradientSubtle}"/>
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BD;"
                          FontSize="42"
                          Foreground="{StaticResource RavenLogoStartBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="Select a message"
                       FontSize="24" FontWeight="ExtraBold"
                       Foreground="{StaticResource RavenText}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Pick a conversation from the list, or start a new one."
                       FontSize="14"
                       Foreground="{StaticResource RavenText3}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="280" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Thread (visible once a conversation is selected) -->
        <Grid x:Name="ThreadRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                        Background="{StaticResource RavenLogoGradient}">
                    <TextBlock x:Name="HeaderInitials" Text="—"
                               FontSize="14" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="HeaderTitle" Text="Conversation"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource RavenText}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource RavenGreenBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderSubtitle"
                                   Text="End-to-end encrypted"
                                   FontSize="11" Foreground="{StaticResource RavenText3}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Width="36" Height="36" Padding="0" CornerRadius="18"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE717;" FontSize="14"
                                  Foreground="{StaticResource RavenText2}"/>
                    </Button>
                    <Button Width="36" Height="36" Padding="0" CornerRadius="18"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE714;" FontSize="14"
                                  Foreground="{StaticResource RavenText2}"/>
                    </Button>
                    <Button Width="36" Height="36" Padding="0" CornerRadius="18"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14"
                                  Foreground="{StaticResource RavenText2}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                    Background="{StaticResource RavenBorder}"/>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" Padding="20,16" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="MessageList">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:MessageVm">
                            <Grid HorizontalAlignment="{x:Bind AlignmentBinding}" MaxWidth="540">
                                <Border Padding="14,10" CornerRadius="14"
                                        Background="{x:Bind BubbleBackground}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind SenderLabel}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{x:Bind SenderForeground}"
                                                   Visibility="{x:Bind SenderVisibility}"/>
                                        <TextBlock Text="{x:Bind Body}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="{x:Bind BubbleForeground}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind TimeText}" FontSize="10"
                                                       Foreground="{x:Bind MetaForeground}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Composer -->
            <Border Grid.Row="2" Margin="16,8,16,16" Padding="6"
                    Background="{StaticResource RavenBgCard}"
                    CornerRadius="999">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Width="36" Height="36" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="18">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="14"
                                  Foreground="{StaticResource RavenLogoStartBrush}"/>
                    </Button>
                    <TextBox Grid.Column="1" x:Name="ComposeBox"
                             PlaceholderText="Message…"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource RavenText}"
                             FontSize="14" Padding="6,8" VerticalAlignment="Center"
                             KeyDown="OnComposeKeyDown"/>
                    <Button Grid.Column="2" Click="OnSendClicked"
                            Width="40" Height="40" Padding="0" CornerRadius="20"
                            Background="{StaticResource RavenBrandGradient}" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;" FontSize="14"
                                  Foreground="White"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
