<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RAVEN.Windows.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:RAVEN.Windows.Ui"
    Title="RAVEN">

    <!--
      Three-column shell. Mirrors Mac's `MacShellView`:
        Rail (240) │ Main column │ Right pane (340)

      The main column hosts five swappable views (Home / Explore /
      Notifications / Messages / Profile); the right pane swaps between
      ChatThreadView (when Section == Messages) and WidgetsView. Section
      changes are driven by `App.ShellRouter` — the rail items set it,
      everything else reacts.
    -->

    <Grid Background="{StaticResource RavenBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- COL 0: Rail -->
        <local:RailView Grid.Column="0"/>

        <!-- Vertical hairline divider -->
        <Border Grid.Column="1" Background="{StaticResource RavenBorder}" Width="1"/>

        <!-- COL 1: Main column — switches by section -->
        <Grid Grid.Column="2">
            <local:HomeView          x:Name="HomeHost"         Visibility="Visible"/>
            <local:ExploreView       x:Name="ExploreHost"      Visibility="Collapsed"/>
            <local:NotificationsView x:Name="NotificationsHost" Visibility="Collapsed"/>
            <local:ChatListColumn    x:Name="ChatListHost"     Visibility="Collapsed"/>
            <local:ProfileView       x:Name="ProfileHost"      Visibility="Collapsed"/>
        </Grid>

        <!-- Vertical hairline divider -->
        <Border Grid.Column="3" Background="{StaticResource RavenBorder}" Width="1"/>

        <!-- COL 2: Right pane (chat thread or widgets) -->
        <local:RightPane Grid.Column="4"/>
    </Grid>
</Window>
