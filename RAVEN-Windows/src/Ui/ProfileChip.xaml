<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RAVEN.Windows.Ui.ProfileChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!--
      Profile chip pinned at the bottom of the rail. Mirrors Mac's
      `ProfileChip` (RailView.swift L114). 36×36 avatar (logo gradient
      fallback when no image) + name + @handle + ellipsis affordance,
      all inside a hover-capsule.
    -->
    <Border x:Name="RowBorder" CornerRadius="999" Padding="12,10"
            Background="Transparent"
            PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                    Background="{StaticResource RavenLogoGradient}">
                <TextBlock x:Name="AvatarLetter"
                           FontSize="15" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="DisplayName" Text="Sign in"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource RavenText}"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <TextBlock x:Name="Handle" Text="@local"
                           FontSize="12"
                           Foreground="{StaticResource RavenText3}"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
            </StackPanel>

            <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons"
                      Glyph="&#xE712;" FontSize="13"
                      Foreground="{StaticResource RavenText3}"
                      VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
