<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RAVEN.Windows.Ui.FeedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:RAVEN.Windows.Ui">

    <!--
      Feed view — Echo Wall posts. Mirrors iOS Feed.
        - Composer at top (capsule input + scope picker + publish button)
        - Vertical list of post cards, glass-styled
        - Each post: avatar, name, timestamp, body, mesh-status pill
    -->

    <Border Background="{StaticResource RavenBgCard}"
            BorderBrush="{StaticResource RavenBorder}" BorderThickness="1"
            CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="24,18,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Echo Wall"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource RavenText}"/>
                    <TextBlock Text="Algorithm-free · syncs over the mesh"
                               FontSize="12"
                               Foreground="{StaticResource RavenText3}"/>
                </StackPanel>
                <Button Grid.Column="1" Width="36" Height="36" Padding="0"
                        ToolTipService.ToolTip="Refresh"
                        Background="{StaticResource RavenBgCardHover}"
                        BorderBrush="{StaticResource RavenBorder}" BorderThickness="1"
                        CornerRadius="18">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="13"
                              Foreground="{StaticResource RavenText}"/>
                </Button>
            </Grid>

            <!-- Composer -->
            <Border Grid.Row="1" Margin="20,0,20,16" Padding="16"
                    Background="{StaticResource RavenBgCardHover}"
                    BorderBrush="{StaticResource RavenBorder}" BorderThickness="1"
                    CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" x:Name="ComposeBox"
                             PlaceholderText="What's on your mind? — encrypted, broadcast over the mesh"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="48"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource RavenText}"
                             FontSize="14"/>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Scope picker (Public / Friends / Local) -->
                        <ComboBox Grid.Column="0" x:Name="ScopePicker" SelectedIndex="0"
                                  Background="{StaticResource RavenBgCard}"
                                  BorderBrush="{StaticResource RavenBorder}" BorderThickness="1"
                                  CornerRadius="999" MinWidth="120" Padding="14,4"
                                  Foreground="{StaticResource RavenText}">
                            <ComboBoxItem Content="🌍 Public"/>
                            <ComboBoxItem Content="👥 Friends"/>
                            <ComboBoxItem Content="📍 Local mesh"/>
                        </ComboBox>

                        <!-- Spacer -->
                        <Border Grid.Column="1"/>

                        <!-- Publish button -->
                        <Button Grid.Column="2" x:Name="PublishButton" Click="OnPublishClicked"
                                Padding="22,10" CornerRadius="999"
                                Background="{StaticResource RavenBrandGradient}"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"
                                          FontSize="13" Foreground="White"/>
                                <TextBlock Text="Publish" FontWeight="SemiBold"
                                           Foreground="White" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Posts list -->
            <ScrollViewer Grid.Row="2" Padding="20,0,20,20" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="PostList">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:PostVm">
                            <Border Padding="18" CornerRadius="18"
                                    Background="{StaticResource RavenBgCardHover}"
                                    BorderBrush="{StaticResource RavenBorder}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: avatar + name + scope + time -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                Background="{StaticResource RavenBrandGradientSubtle}"
                                                BorderBrush="{StaticResource RavenBorder}" BorderThickness="1">
                                            <TextBlock Text="{x:Bind AuthorInitials}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource RavenText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind AuthorUsername}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource RavenText}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind ScopeIcon}" FontSize="11"/>
                                                <TextBlock Text="{x:Bind ScopeLabel}"
                                                           FontSize="11" Foreground="{StaticResource RavenText3}"/>
                                                <TextBlock Text="·" Foreground="{StaticResource RavenText3}"/>
                                                <TextBlock Text="{x:Bind TimeText}"
                                                           FontSize="11" Foreground="{StaticResource RavenText3}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="2" Width="32" Height="32" Padding="0" CornerRadius="16"
                                                Background="Transparent" BorderThickness="0">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="13"
                                                      Foreground="{StaticResource RavenText3}"/>
                                        </Button>
                                    </Grid>

                                    <!-- Body -->
                                    <TextBlock Grid.Row="1" Text="{x:Bind Body}"
                                               TextWrapping="Wrap"
                                               FontSize="14" Margin="0,12,0,0"
                                               Foreground="{StaticResource RavenText}"/>

                                    <!-- Footer: mesh route badge + reactions -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                                                Margin="0,14,0,0">
                                        <Border Padding="8,4" CornerRadius="999"
                                                Background="{StaticResource RavenBgCard}"
                                                BorderBrush="{StaticResource RavenBorder}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind RouteIcon}"
                                                          FontSize="11" Foreground="{StaticResource RavenText2}"/>
                                                <TextBlock Text="{x:Bind RouteLabel}"
                                                           FontSize="11" FontWeight="Medium"
                                                           Foreground="{StaticResource RavenText2}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="8,4" CornerRadius="999"
                                                Background="{StaticResource RavenBgCard}"
                                                BorderBrush="{StaticResource RavenBorder}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE0E2;"
                                                          FontSize="11" Foreground="{StaticResource RavenText2}"/>
                                                <TextBlock Text="{x:Bind LikeCountText}"
                                                           FontSize="11" Foreground="{StaticResource RavenText2}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="8,4" CornerRadius="999"
                                                Background="{StaticResource RavenBgCard}"
                                                BorderBrush="{StaticResource RavenBorder}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F2;"
                                                          FontSize="11" Foreground="{StaticResource RavenText2}"/>
                                                <TextBlock Text="{x:Bind CommentCountText}"
                                                           FontSize="11" Foreground="{StaticResource RavenText2}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
