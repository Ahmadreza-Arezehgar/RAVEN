<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RAVEN.Windows.Ui.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:RAVEN.Windows.Ui">

    <!--
      Home (Echo Wall feed) — middle pane on the Home tab. Mirrors
      `RAVEN-MacApp/RAVEN/Views/Components/FeedView.swift`. Sticky header
      with "Home" title + For-you/Friends/Local tab strip, compose card,
      then a vertical list of post cards.
    -->
    <ScrollView Background="{StaticResource RavenBg}">
        <StackPanel Spacing="0" MaxWidth="720" HorizontalAlignment="Stretch">

            <!-- Header -->
            <TextBlock Text="Home"
                       FontSize="22" FontWeight="ExtraBold"
                       Foreground="{StaticResource RavenText}"
                       Padding="20,18,0,14"/>

            <StackPanel Orientation="Horizontal" Padding="4,0">
                <Button x:Name="TabForYou" Padding="16,12" Background="Transparent"
                        BorderThickness="0" Click="OnTabClicked" Tag="forYou">
                    <StackPanel Spacing="8">
                        <TextBlock Text="For you" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource RavenText}"
                                   HorizontalAlignment="Center"/>
                        <Border Width="36" Height="3" CornerRadius="999"
                                Background="{StaticResource RavenBrandGradient}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabFriends" Padding="16,12" Background="Transparent"
                        BorderThickness="0" Click="OnTabClicked" Tag="friends">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Friends" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource RavenText3}"
                                   HorizontalAlignment="Center"/>
                        <Border Width="36" Height="3" CornerRadius="999"
                                Background="Transparent"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabLocal" Padding="16,12" Background="Transparent"
                        BorderThickness="0" Click="OnTabClicked" Tag="local">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Local" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource RavenText3}"
                                   HorizontalAlignment="Center"/>
                        <Border Width="36" Height="3" CornerRadius="999"
                                Background="Transparent"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Height="1" Background="{StaticResource RavenBorder}"/>

            <!-- Composer -->
            <Grid Padding="20,16,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                        Background="{StaticResource RavenLogoGradient}"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="ComposeAvatarLetter"
                               Text="?"
                               FontSize="16" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="12">
                    <TextBox x:Name="ComposeBox"
                             PlaceholderText="What's happening?"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="44"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource RavenText}"
                             FontSize="18"/>
                    <Button HorizontalAlignment="Right" Padding="22,10" CornerRadius="999"
                            Background="{StaticResource RavenBrandGradient}"
                            BorderThickness="0"
                            Click="OnPublishClicked">
                        <TextBlock Text="Post" FontSize="14" FontWeight="ExtraBold"
                                   Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{StaticResource RavenBorder}" Margin="0,16,0,0"/>

            <!-- Posts list -->
            <ItemsRepeater x:Name="PostList" Margin="16,12">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:PostVm">
                        <Border Padding="18" CornerRadius="18"
                                Background="{StaticResource RavenBgCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                            Background="{StaticResource RavenLogoGradient}">
                                        <TextBlock Text="{x:Bind AuthorInitials}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind AuthorUsername}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource RavenText}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind ScopeIcon}" FontSize="11"/>
                                            <TextBlock Text="{x:Bind ScopeLabel}"
                                                       FontSize="11" Foreground="{StaticResource RavenText3}"/>
                                            <TextBlock Text="·" Foreground="{StaticResource RavenText3}"/>
                                            <TextBlock Text="{x:Bind TimeText}"
                                                       FontSize="11" Foreground="{StaticResource RavenText3}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="32" Height="32" Padding="0" CornerRadius="16"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="13"
                                                  Foreground="{StaticResource RavenText3}"/>
                                    </Button>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{x:Bind Body}"
                                           TextWrapping="Wrap"
                                           FontSize="14" Margin="0,12,0,0"
                                           Foreground="{StaticResource RavenText}"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                                            Margin="0,14,0,0">
                                    <Border Padding="8,4" CornerRadius="999"
                                            Background="{StaticResource RavenBgCardHover}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB52;"
                                                      FontSize="11" Foreground="{StaticResource RavenText2}"/>
                                            <TextBlock Text="{x:Bind LikeCountText}"
                                                       FontSize="11" Foreground="{StaticResource RavenText2}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="8,4" CornerRadius="999"
                                            Background="{StaticResource RavenBgCardHover}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BD;"
                                                      FontSize="11" Foreground="{StaticResource RavenText2}"/>
                                            <TextBlock Text="{x:Bind CommentCountText}"
                                                       FontSize="11" Foreground="{StaticResource RavenText2}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Height="80"/>
        </StackPanel>
    </ScrollView>
</UserControl>
