<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RAVEN.Windows.Ui.ExploreView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:RAVEN.Windows.Ui">

    <!--
      Explore (search + trending) — middle pane on the Explore tab.
      Mirrors `ExploreColumn.swift`. Visual layout matches; the search
      and trending fetches will wire up once ApiClient gets the matching
      endpoint methods.
    -->
    <ScrollView Background="{StaticResource RavenBg}">
        <StackPanel Spacing="0" MaxWidth="720" HorizontalAlignment="Stretch">

            <TextBlock Text="Explore"
                       FontSize="22" FontWeight="ExtraBold"
                       Foreground="{StaticResource RavenText}"
                       Padding="20,18,0,12"/>

            <Border Margin="16,0,16,16" Padding="14,10"
                    Background="{StaticResource RavenBgCard}"
                    CornerRadius="999">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;" FontSize="13"
                              Foreground="{StaticResource RavenText3}"
                              VerticalAlignment="Center"/>
                    <TextBox PlaceholderText="Search people, posts, #tags"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource RavenText}"
                             FontSize="13" MinWidth="220"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Trending hashtags"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource RavenText3}"
                       Padding="20,0,0,4"/>

            <TextBlock Text="No trends right now."
                       FontSize="13"
                       Foreground="{StaticResource RavenText3}"
                       Padding="20,12,20,40"/>
        </StackPanel>
    </ScrollView>
</UserControl>
