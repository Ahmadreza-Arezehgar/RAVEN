# Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# ENVIRONMENT
# ============================================
# Set to 'production' or 'development'
# Controls logging verbosity and security features
ENV=development

# ============================================
# SECURITY
# ============================================
# Set to 'true' when behind a trusted proxy (Cloud Run, Load Balancer)
# Enables X-Forwarded-For header parsing for real client IPs
# WARNING: Only enable this in production with proper proxy configuration
TRUST_PROXY=false

# ============================================
# REDIS (Optional - for distributed rate limiting)
# ============================================
# Redis connection URL for shared rate limiting across instances
# Example: redis://localhost:6379
# Example (Cloud Memorystore): redis://10.0.0.3:6379
# Leave empty to use in-memory rate limiting (dev only)
# REDIS_URL=

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/hybrid_messenger

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CORS
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# AI SERVICES
# ============================================
# Google Gemini API key for AI-powered comment responses
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# EMAIL (Resend API for verification emails)
# ============================================
# Get your API key from: https://resend.com/api-keys
# REQUIRED for email verification to work!
RESEND_API_KEY=re_xxxxxxxxxxxx
# Verified sender domain email
RESEND_FROM_EMAIL=no-reply@raven-messager.com

# ============================================
# APNs PUSH NOTIFICATIONS (iOS)
# ============================================
# Required for push notifications to iOS devices.
# Get credentials from Apple Developer Portal → Keys → Create a new key with APNs.
APNS_KEY_ID=your-key-id
APNS_TEAM_ID=your-team-id
APNS_BUNDLE_ID=app.raven.ios
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# Set to 'false' for production builds, 'true' for development/TestFlight
APNS_USE_SANDBOX=true

# ============================================
# GOOGLE CLOUD STORAGE (Media uploads)
# ============================================
# GCS bucket for persistent media storage (images, voice, files)
# Required in production (Cloud Run). Falls back to local filesystem in dev.
GCS_MEDIA_BUCKET=raven-media-uploads

# ============================================
# REVENUECAT (In-App Purchase Webhooks)
# ============================================
# Shared secret for authenticating RevenueCat webhook requests
# Must match the Authorization header configured in RevenueCat Dashboard
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
