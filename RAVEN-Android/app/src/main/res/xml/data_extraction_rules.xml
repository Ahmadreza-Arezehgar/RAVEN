<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules: nothing leaves the device. The whole
     point of RAVEN is local-first crypto material; we never want
     Google Drive's auto-backup to spill tokens or the SQLCipher
     passphrase off-device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
