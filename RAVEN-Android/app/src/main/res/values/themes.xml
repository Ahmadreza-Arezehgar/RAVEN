<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Splash theme — what the OS shows between cold-start and the
         first Compose frame. Matches Android 12+ SplashScreen API. -->
    <style name="Theme.Raven.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/raven_splash_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Raven</item>
    </style>

    <style name="Theme.Raven" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
    </style>
</resources>
